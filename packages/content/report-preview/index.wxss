page {
  background: #f8faf5;
  --green-primary: #3075B8;
  --green-soft: #EAF3FB;
  --green-mid: #3075B8;
  --text-main: #26352a;
  --text-sub: #6f806f;
  --text-light: #9aab9d;
}

.report-preview-page {
  min-height: 100vh;
  padding-bottom: 56rpx;
  color: var(--text-main);
}

.hero {
  padding: 48rpx 32rpx 36rpx;
  background: linear-gradient(180deg, #F5FAFF 0%, #F8FAFD 100%);
}

.hero-copy,
.section-head,
.lab-copy,
.product-copy,
.report-points,
.metric-card,
.bottom-cta {
  display: flex;
  flex-direction: column;
}

.hero-kicker {
  font-size: 22rpx;
  color: var(--green-primary);
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 20rpx;
}

.hero-desc {
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--text-sub);
}

.hero-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.primary-btn,
.ghost-btn,
.bottom-btn {
  min-width: 196rpx;
  height: 76rpx;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.primary-btn,
.bottom-btn {
  background: var(--green-primary);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(48, 117, 184, 0.18);
}

.ghost-btn {
  background: #ffffff;
  color: var(--green-primary);
  border: 1rpx solid rgba(48, 117, 184, 0.22);
}

.hero-visual {
  position: relative;
  margin-top: 40rpx;
}

.image-placeholder {
  background: linear-gradient(135deg, #EEF6FD 0%, #DDECF9 100%);
  border: 2rpx dashed rgba(48, 117, 184, 0.22);
  color: #6E8EAE;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.hero-visual > .image-placeholder {
  height: 360rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
}

.hero-report-card {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 30rpx rgba(39, 80, 45, 0.1);
  display: flex;
  flex-direction: column;
}

.report-card-title {
  font-size: 22rpx;
  color: var(--text-light);
}

.report-card-main {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--green-primary);
  margin-top: 8rpx;
}

.report-card-sub {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

.section {
  padding: 40rpx 32rpx 0;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 14rpx;
}

.section-desc {
  font-size: 25rpx;
  line-height: 1.75;
  color: var(--text-sub);
}

.value-grid,
.product-list,
.metric-list,
.chart-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 26rpx;
}

.value-card,
.product-card,
.lab-panel,
.report-preview,
.metric-card,
.score-chart,
.bar-chart,
.trend-chart,
.radar-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(48, 117, 184, 0.06);
}

.value-card {
  padding: 28rpx;
  display: grid;
  grid-template-columns: 88rpx 1fr;
  column-gap: 22rpx;
  row-gap: 8rpx;
  align-items: center;
}

.icon-placeholder {
  grid-row: 1 / span 2;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #EEF6FD;
  color: #6E8EAE;
  border: 1rpx dashed rgba(48, 117, 184, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.value-title {
  font-size: 28rpx;
  font-weight: 700;
}

.value-desc,
.product-desc,
.metric-desc,
.point-desc,
.lab-desc {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-sub);
}

.lab-panel {
  margin-top: 26rpx;
  overflow: hidden;
}

.lab-image {
  height: 300rpx;
  font-size: 28rpx;
}

.lab-copy {
  padding: 28rpx;
}

.lab-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.lab-stats {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.lab-stat {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.lab-stat-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--green-primary);
  margin-bottom: 8rpx;
}

.lab-stat-label {
  font-size: 20rpx;
  color: var(--text-light);
  text-align: center;
  line-height: 1.35;
}

.product-card {
  position: relative;
  overflow: hidden;
}

.product-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 1;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(48, 117, 184, 0.9);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.product-image {
  height: 240rpx;
  font-size: 26rpx;
}

.product-copy {
  padding: 24rpx 28rpx 30rpx;
}

.product-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.report-preview {
  margin-top: 26rpx;
  padding: 24rpx;
}

.report-phone {
  height: 420rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
}

.report-points {
  gap: 16rpx;
  margin-top: 24rpx;
}

.report-point {
  padding: 22rpx 24rpx;
  background: #f8fbf6;
  border-radius: 18rpx;
}

.point-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.score-chart {
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.score-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.24s linear;
}

.score-core {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-value {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--green-primary);
  line-height: 1;
}

.score-label {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.score-copy {
  flex: 1;
}

.score-title,
.chart-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.score-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--text-sub);
  margin-top: 10rpx;
}

.bar-chart,
.trend-chart,
.radar-card {
  padding: 28rpx;
}

.chart-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.chart-note {
  font-size: 22rpx;
  color: var(--text-light);
}

.bar-row {
  display: grid;
  grid-template-columns: 176rpx 1fr 72rpx;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 22rpx;
}

.bar-row:last-child {
  margin-bottom: 0;
}

.bar-meta {
  min-width: 0;
}

.bar-name {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-main);
}

.bar-status {
  display: block;
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bar-track,
.radar-track,
.metric-progress {
  height: 16rpx;
  border-radius: 999rpx;
  background: #edf4ec;
  overflow: hidden;
}

.bar-fill,
.radar-fill,
.metric-progress-fill {
  height: 100%;
  border-radius: inherit;
  transition: width 0.24s linear;
}

.bar-value {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--green-primary);
  text-align: right;
}

.trend-canvas {
  position: relative;
  height: 260rpx;
  background: linear-gradient(180deg, #fbfdf9 0%, #f2f8f1 100%);
  border-radius: 22rpx;
  overflow: hidden;
}

.trend-line {
  position: absolute;
  left: 9%;
  right: 10%;
  top: 52%;
  height: 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(48, 117, 184, 0.2), rgba(48, 117, 184, 0.85));
  transform: rotate(-11deg);
  opacity: 0;
  transform-origin: left center;
}

.trend-node {
  position: absolute;
  width: 126rpx;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
}

.chart-section--active .score-ring {
  animation: ringPulse 0.8s ease-out 0.55s both;
}

.chart-section--active .trend-line {
  animation: revealLine 0.85s ease-out 0.12s both, lineGlow 2.2s ease-in-out 1s infinite;
}

.chart-section--active .trend-node {
  animation: revealNode 0.48s ease-out both, floatNode 2.6s ease-in-out 0.8s infinite;
}

.chart-section--active .trend-node:nth-child(3) {
  animation-delay: 0.16s, 0.96s;
}

.chart-section--active .trend-node:nth-child(4) {
  animation-delay: 0.32s, 1.12s;
}

.chart-section--active .trend-node:nth-child(5) {
  animation-delay: 0.48s, 1.28s;
}

.chart-section--active .trend-node:nth-child(6) {
  animation-delay: 0.64s, 1.44s;
}

.trend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--green-primary);
  box-shadow: 0 0 0 10rpx rgba(48, 117, 184, 0.12);
  margin-bottom: 14rpx;
}

.trend-value {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--text-main);
  white-space: nowrap;
}

.trend-label {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.radar-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.radar-item {
  display: grid;
  grid-template-columns: 90rpx 1fr 52rpx;
  gap: 16rpx;
  align-items: center;
}

.radar-name {
  font-size: 24rpx;
  color: var(--text-sub);
}

.radar-fill {
  background: linear-gradient(90deg, #8FBCE6, var(--green-primary));
}

.radar-value {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--green-primary);
  text-align: right;
}

.metric-card {
  padding: 28rpx;
}

.metric-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.metric-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.metric-value-wrap {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  color: var(--green-primary);
}

.metric-value {
  font-size: 42rpx;
  font-weight: 800;
}

.metric-unit {
  font-size: 22rpx;
  font-weight: 600;
  margin-left: 4rpx;
}

.metric-progress {
  margin-bottom: 16rpx;
}

.metric-progress-fill--balance {
  width: 82%;
  background: linear-gradient(90deg, #8FBCE6, var(--green-primary));
}

.bottom-cta {
  margin: 44rpx 32rpx 0;
  padding: 38rpx 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #EAF3FB 0%, #ffffff 100%);
  align-items: center;
  text-align: center;
}

.bottom-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.bottom-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-sub);
  margin-top: 12rpx;
}

.bottom-btn {
  width: 100%;
  margin-top: 28rpx;
}

@keyframes ringPulse {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(48, 117, 184, 0.14);
  }

  50% {
    transform: scale(1.025);
    box-shadow: 0 0 0 14rpx rgba(48, 117, 184, 0);
  }
}

@keyframes revealLine {
  from {
    opacity: 0;
    transform: rotate(-11deg) scaleX(0);
  }

  to {
    opacity: 0.82;
    transform: rotate(-11deg) scaleX(1);
  }
}

@keyframes revealNode {
  from {
    opacity: 0;
    transform: translateY(calc(-50% + 20rpx)) scale(0.92);
  }

  to {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }
}

@keyframes lineGlow {
  0%,
  100% {
    opacity: 0.72;
  }

  50% {
    opacity: 1;
  }
}

@keyframes floatNode {
  0%,
  100% {
    transform: translateY(-50%);
  }

  50% {
    transform: translateY(calc(-50% - 8rpx));
  }
}
