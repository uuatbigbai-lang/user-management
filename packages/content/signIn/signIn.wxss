/* packages/content/signIn/signIn.wxss */
page {
  background: linear-gradient(135deg, #3075B8 0%, #245F99 100%);
  min-height: 100vh;
}

.signin-container {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* Banner 部分样式 */
.banner-section {
  position: relative;
  height: 400rpx;
  margin-bottom: 40rpx;
}

.banner-image {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 0 0 60rpx 60rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #3075B8 0%, #4A8DCD 45%, #7BB2E3 100%);
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.1);
}

.banner-img {
  width: 100%;
  height: 100%;
  opacity: 0.8;
}

.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, rgba(48, 117, 184, 0.8) 0%, rgba(36, 95, 153, 0.8) 100%);
}

.banner-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 4rpx;
}

.banner-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 2rpx;
}

/* 表单部分样式 */
.form-section {
  position: relative;
  z-index: 2;
  padding: 0 40rpx;
}

.form-container {
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx 80rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.form-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.form-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.form-content {
  margin-bottom: 60rpx;
}

.input-group {
  margin-bottom: 40rpx;
}

.input-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.label-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.required-mark {
  color: #ff4757;
  font-size: 28rpx;
  margin-left: 8rpx;
}

/* 自定义输入框样式 */
.custom-input {
  --td-input-border-radius: 16rpx;
  --td-input-bg-color: #f8f9fa;
  --td-input-border-color: #e9ecef;
  --td-input-placeholder-color: #adb5bd;
  --td-input-text-color: #333;
  --td-input-font-size: 30rpx;
  --td-input-height: 88rpx;
  --td-input-padding: 0 24rpx;
  border: 2rpx solid #e9ecef;
  transition: all 0.3s ease;
}

.custom-input:focus-within {
  border-color: #3075B8;
  box-shadow: 0 0 0 6rpx rgba(48, 117, 184, 0.1);
  transform: translateY(-2rpx);
}

/* 按钮部分样式 */
.button-section {
  margin-top: 40rpx;
}

.submit-button {
  --td-button-default-height: 96rpx;
  --td-button-default-font-size: 32rpx;
  --td-button-primary-bg-color: linear-gradient(135deg, #3075B8 0%, #245F99 100%);
  --td-button-primary-border-color: transparent;
  --td-button-primary-color: #fff;
  --td-button-border-radius: 48rpx;
  
  position: relative;
  overflow: hidden;
  font-weight: bold;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 24rpx rgba(48, 117, 184, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background-color: #3075B8 !important;

}

.submit-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s;
}

.submit-button:active::before {
  left: 100%;
}

.submit-button:active {
  transform: translateY(2rpx);
  box-shadow: 0 8rpx 16rpx rgba(48, 117, 184, 0.4);
}

.submit-button[disabled] {
  background-color: #e9ecef !important;
  color: #adb5bd !important;
  box-shadow: none !important;
  transform: none !important;
}

/* 装饰元素 */
.decoration-elements {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 1;
}

.decoration-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  animation: float 6s ease-in-out infinite;
}

.circle-1 {
  width: 120rpx;
  height: 120rpx;
  top: 10%;
  right: 10%;
  animation-delay: 0s;
}

.circle-2 {
  width: 80rpx;
  height: 80rpx;
  bottom: 20%;
  left: 15%;
  animation-delay: 2s;
}

.circle-3 {
  width: 60rpx;
  height: 60rpx;
  top: 60%;
  right: 20%;
  animation-delay: 4s;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0px) rotate(0deg);
    opacity: 0.5;
  }
  50% {
    transform: translateY(-20rpx) rotate(180deg);
    opacity: 0.8;
  }
}

/* 响应式适配 */
@media (max-width: 375px) {
  .form-container {
    padding: 40rpx 30rpx 60rpx;
  }
  
  .banner-title {
    font-size: 40rpx;
  }
  
  .banner-subtitle {
    font-size: 24rpx;
  }
}

/* Toast 组件样式覆盖 */
.t-toast {
  --td-toast-bg-color: rgba(0, 0, 0, 0.8);
  --td-toast-text-color: #fff;
  --td-toast-border-radius: 16rpx;
}

/* 成功状态样式 */
.submit-button.success {
  background: linear-gradient(135deg, #3075B8 0%, #245F99 100%) !important;
}

/* 加载状态样式 */
.submit-button.loading {
  background: linear-gradient(135deg, #6A9FD0 0%, #3075B8 100%) !important;
}

/* 输入框错误状态 */
.custom-input.error {
  border-color: #ff4757 !important;
  box-shadow: 0 0 0 6rpx rgba(255, 71, 87, 0.1) !important;
}

/* 动画增强 */
.form-container {
  animation: slideUp 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.banner-section {
  animation: fadeIn 0.8s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .form-container {
    background: rgba(30, 30, 30, 0.9);
    border: 1rpx solid rgba(255, 255, 255, 0.1);
  }
  
  .form-title {
    color: #fff;
  }
  
  .form-desc {
    color: #ccc;
  }
  
  .label-text {
    color: #fff;
  }
  
  .custom-input {
    --td-input-bg-color: rgba(50, 50, 50, 0.8);
    --td-input-border-color: rgba(255, 255, 255, 0.2);
    --td-input-text-color: #fff;
  }
/* 加载状态样式 */
.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #3075B8 0%, #245F99 100%);
  z-index: 1000;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
  padding: 60rpx 80rpx;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(10rpx);
}

.loading-text {
  font-size: 28rpx;
  color: #666;
  margin-top: 24rpx;
  letter-spacing: 1rpx;
}

/* 主要内容区域 */
.main-content {
  animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 动态表单字段样式 */
.form-content {
  display: flex;
  flex-direction: column;
}

.input-group {
  display: flex;
  flex-direction: column;
  margin-bottom: 40rpx;
  transition: all 0.3s ease;
}

/* 多行文本输入框样式 */
.custom-textarea {
  --td-textarea-border-radius: 16rpx;
  --td-textarea-bg-color: #f8f9fa;
  --td-textarea-border-color: #e9ecef;
  --td-textarea-placeholder-color: #adb5bd;
  --td-textarea-text-color: #333;
  --td-textarea-font-size: 30rpx;
  --td-textarea-padding: 24rpx;
  border: 2rpx solid #e9ecef;
  transition: all 0.3s ease;
  min-height: 120rpx;
}

.custom-textarea:focus-within {
  border-color: #3075B8;
  box-shadow: 0 0 0 6rpx rgba(48, 117, 184, 0.1);
}

/* 选择器样式 */
.custom-picker {
  --td-picker-bg-color: #f8f9fa;
  --td-picker-border-color: #e9ecef;
  --td-picker-border-radius: 16rpx;
}

/* 日期选择器样式 */
.custom-date-picker {
  --td-date-time-picker-bg-color: #f8f9fa;
  --td-date-time-picker-border-color: #e9ecef;
  --td-date-time-picker-border-radius: 16rpx;
}

/* 开关样式 */
.custom-switch {
  --td-switch-on-color: #3075B8;
  --td-switch-off-color: #e9ecef;
  margin-top: 16rpx;
}

/* 单选框组样式 */
.custom-radio-group {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.custom-radio-group .t-radio {
  --td-radio-color: #3075B8;
  --td-radio-label-color: #333;
  --td-radio-font-size: 28rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f8f9fa;
  border: 1rpx solid #e9ecef;
  transition: all 0.3s ease;
}

.custom-radio-group .t-radio[checked] {
  background: rgba(48, 117, 184, 0.1);
  border-color: #3075B8;
}

/* 复选框组样式 */
.custom-checkbox-group {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.custom-checkbox-group .t-checkbox {
  --td-checkbox-color: #3075B8;
  --td-checkbox-label-color: #333;
  --td-checkbox-font-size: 28rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f8f9fa;
  border: 1rpx solid #e9ecef;
  transition: all 0.3s ease;
}

.custom-checkbox-group .t-checkbox[checked] {
  background: rgba(48, 117, 184, 0.1);
  border-color: #3075B8;
}

/* 字段排序支持 */
.form-content {
  display: flex;
  flex-direction: column;
}

/* 字段动画效果 */
.input-group {
  animation: slideInLeft 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 错误状态样式 */
.input-group.error .custom-input,
.input-group.error .custom-textarea {
  border-color: #ff4757;
  box-shadow: 0 0 0 6rpx rgba(255, 71, 87, 0.1);
}

.input-group.error .label-text {
  color: #ff4757;
}

/* 成功状态样式 */
.input-group.success .custom-input,
.input-group.success .custom-textarea {
  border-color: #3075B8;
  box-shadow: 0 0 0 6rpx rgba(48, 117, 184, 0.12);
}

/* 禁用状态样式 */
.input-group.disabled .custom-input,
.input-group.disabled .custom-textarea,
.input-group.disabled .custom-picker,
.input-group.disabled .custom-date-picker {
  opacity: 0.6;
  pointer-events: none;
  background-color: #f1f3f4;
}

.input-group.disabled .label-text {
  color: #adb5bd;
}

/* 响应式布局增强 */
@media (max-width: 320px) {
  .form-container {
    padding: 30rpx 20rpx 50rpx;
  }
  
  .input-group {
    margin-bottom: 30rpx;
  }
  
  .custom-input,
  .custom-textarea {
    --td-input-font-size: 28rpx;
    --td-textarea-font-size: 28rpx;
  }
}

/* 深色模式适配增强 */
@media (prefers-color-scheme: dark) {
  .loading-content {
    background: rgba(30, 30, 30, 0.95);
  }
  
  .loading-text {
    color: #ccc;
  }
  
  .custom-textarea {
    --td-textarea-bg-color: rgba(50, 50, 50, 0.8);
    --td-textarea-border-color: rgba(255, 255, 255, 0.2);
    --td-textarea-text-color: #fff;
  }
  
  .custom-radio-group .t-radio,
  .custom-checkbox-group .t-checkbox {
    background: rgba(50, 50, 50, 0.8);
    border-color: rgba(255, 255, 255, 0.2);
    --td-radio-label-color: #fff;
    --td-checkbox-label-color: #fff;
  }
}
}
