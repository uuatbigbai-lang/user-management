/* packages/content/signInSuccess/signInSuccess.wxss */
page {
  background: linear-gradient(135deg, #3075B8 0%, #245F99 100%);
  min-height: 100vh;
  overflow-x: hidden;
}

.success-container {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

/* 背景装饰 */
.background-decoration {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 1;
}

.decoration-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  animation: float 8s ease-in-out infinite;
}

.circle-1 {
  width: 200rpx;
  height: 200rpx;
  top: 10%;
  right: -50rpx;
  animation-delay: 0s;
}

.circle-2 {
  width: 120rpx;
  height: 120rpx;
  bottom: 20%;
  left: -30rpx;
  animation-delay: 2s;
}

.circle-3 {
  width: 80rpx;
  height: 80rpx;
  top: 30%;
  left: 20%;
  animation-delay: 4s;
}

.circle-4 {
  width: 150rpx;
  height: 150rpx;
  bottom: 10%;
  right: 10%;
  animation-delay: 6s;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0px) rotate(0deg);
    opacity: 0.3;
  }
  50% {
    transform: translateY(-30rpx) rotate(180deg);
    opacity: 0.6;
  }
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 24rpx;
}

/* 主要内容 */
.main-content {
  /* position: relative; */
  z-index: 5;
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 成功图标区域 */
.success-icon-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  opacity: 0;
  transform: scale(0.5) translateY(50rpx);
  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.success-icon-section.show {
  opacity: 1;
  transform: scale(1) translateY(0);
}

/* 成功圆环 */
.success-circle-outer {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  animation: pulse 2s ease-in-out infinite;
}

.success-circle-middle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-circle-inner {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.2);
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.4);
  }
  50% {
    transform: scale(1.05);
    box-shadow: 0 0 0 20rpx rgba(255, 255, 255, 0);
  }
}

/* PNG 对勾图片 */
.checkmark-container {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkmark-image {
  width: 120rpx;
  height: 120rpx;
  animation: checkmark-appear 0.6s ease-out 0.3s both;
}

@keyframes checkmark-appear {
  0% {
    opacity: 0;
    transform: scale(0.5);
  }
  50% {
    transform: scale(1.1);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* 成功标题 */
.success-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 2rpx;
}

/* 详细信息区域 */
.info-section {
  width: 100%;
  margin-bottom: 50rpx;
  opacity: 0;
  transform: translateY(30rpx);
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.4s;
}

.info-section.show {
  opacity: 1;
  transform: translateY(0);
}

.info-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(10rpx);
}

.info-header {
  text-align: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.info-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.info-subtitle {
  font-size: 26rpx;
  color: #7f8c8d;
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.info-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border-left: 6rpx solid #3075B8;
}

.info-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.info-text {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 28rpx;
  color: #34495e;
  font-weight: 500;
}

.info-value {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: bold;
}

/* 操作按钮区域 */
.action-section {
  width: 100%;
  margin-bottom: 50rpx;
  opacity: 0;
  transform: translateY(30rpx);
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.6s;
}

.action-section.show {
  opacity: 1;
  transform: translateY(0);
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  align-items: center;
}

.primary-button {
  width: 100%;
  --td-button-default-height: 96rpx;
  --td-button-default-font-size: 32rpx;
  --td-button-primary-bg-color: linear-gradient(135deg, #3075B8 0%, #245F99 100%);
  --td-button-primary-border-color: transparent;
  --td-button-border-radius: 48rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 24rpx rgba(48, 117, 184, 0.28);
}

.secondary-buttons {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.secondary-button {
  flex: 1;
  --td-button-default-height: 72rpx;
  --td-button-default-font-size: 28rpx;
  --td-button-default-border-color: rgba(255, 255, 255, 0.8);
  --td-button-default-color: rgba(255, 255, 255, 0.9);
  --td-button-border-radius: 36rpx;
  backdrop-filter: blur(10rpx);
}

/* 鼓励文字区域 */
.encouragement-section {
  width: 100%;
  text-align: center;
  margin-bottom: 60rpx;
  opacity: 0;
  transform: translateY(30rpx);
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.8s;
}

.encouragement-section.show {
  opacity: 1;
  transform: translateY(0);
}

.encouragement-text {
  margin-bottom: 0;
}

.encouragement-main {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.encouragement-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

/* 底部品牌区域 */
.brand-section {
  position: absolute;
  bottom: 10vh;
  left: 0;
  right: 0;
  width: 100%;
  text-align: center;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1) 1.2s;
}

.brand-section.show {
  opacity: 1;
  transform: translateY(0);
}

.encouragement-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

/* 进度装饰 */
.progress-decoration {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.progress-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
}

.dot.active {
  background: #3075B8;
  box-shadow: 0 0 16rpx rgba(76, 175, 80, 0.6);
  animation: dot-glow 2s ease-in-out infinite;
}

@keyframes dot-glow {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.2);
  }
}

.progress-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 底部装饰 */
.bottom-decoration {
  position: absolute;
  bottom: 40rpx;
  left: 0;
  right: 0;
  pointer-events: none;
}

.sparkle {
  position: absolute;
  font-size: 32rpx;
  animation: sparkle 3s ease-in-out infinite;
}

.sparkle-1 {
  left: 20%;
  animation-delay: 0s;
}

.sparkle-2 {
  right: 25%;
  animation-delay: 0.8s;
}

.sparkle-3 {
  left: 60%;
  animation-delay: 1.6s;
}

.sparkle-4 {
  right: 10%;
  animation-delay: 2.4s;
}

@keyframes sparkle {
  0%, 100% {
    opacity: 0;
    transform: scale(0.5) rotate(0deg);
  }
  50% {
    opacity: 1;
    transform: scale(1) rotate(180deg);
  }
}

/* 响应式适配 */
@media (max-width: 375px) {
  .success-container {
    padding: 30rpx 20rpx;
  }
  
  .success-circle-outer {
    width: 200rpx;
    height: 200rpx;
  }
  
  .success-circle-middle {
    width: 160rpx;
    height: 160rpx;
  }
  
  .success-circle-inner {
    width: 120rpx;
    height: 120rpx;
  }
  
  .checkmark-container {
    width: 80rpx;
    height: 80rpx;
  }
  
  .success-title {
    font-size: 40rpx;
  }
  
  .info-card {
    padding: 30rpx;
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .info-card {
    background: rgba(30, 30, 30, 0.95);
  }
  
  .info-title {
    color: #fff;
  }
  
  .info-subtitle {
    color: #ccc;
  }
  
  .info-item {
    background: rgba(50, 50, 50, 0.8);
    border-left-color: #3075B8;
  }
  
  .info-label,
  .info-value {
    color: #fff;
  }
}
