page {
  background: #f8faf5;
  --green-primary: #3075b8;
  --green-dark: #245f99;
  --text-main: #2d3a2e;
  --text-sub: #7a8a7c;
  --text-light: #a3b5a6;
}

.about-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ========== Hero ========== */
.hero {
  position: relative;
  padding: 72rpx 48rpx 56rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: -60rpx -40rpx -40rpx;
  background: linear-gradient(160deg, #eaf3fb 0%, #d7e9f8 35%, #b8d4ef 65%, #eaf3fb 100%);
  border-radius: 0 0 56rpx 56rpx;
  z-index: 0;
}

.hero-deco {
  position: absolute;
  border-radius: 50%;
  z-index: 0;
}

.hero-deco-1 {
  width: 260rpx;
  height: 260rpx;
  top: -50rpx;
  right: -30rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.4) 0%, transparent 70%);
}

.hero-deco-2 {
  width: 140rpx;
  height: 140rpx;
  bottom: 10rpx;
  left: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.hero-deco-3 {
  width: 80rpx;
  height: 80rpx;
  top: 60rpx;
  right: 160rpx;
  background: rgba(255, 255, 255, 0.2);
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-tag {
  font-size: 20rpx;
  color: var(--green-primary);
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.hero-sub {
  font-size: 26rpx;
  color: var(--green-dark);
  letter-spacing: 2rpx;
}

/* ========== Section ========== */
.section {
  padding: 44rpx 40rpx 0;
}

.sec-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.sec-line {
  width: 48rpx;
  height: 2rpx;
  background: var(--green-primary);
  opacity: 0.35;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin: 0 20rpx;
  letter-spacing: 4rpx;
}

/* ========== Card ========== */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(48, 117, 184, 0.06);
}

.card-text {
  font-size: 24rpx;
  color: var(--text-main);
  line-height: 1.9;
  display: block;
}

/* ========== 核心业务 ========== */
.biz-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(48, 117, 184, 0.06);
  align-items: center;
  justify-content: center;
}

.biz-icon-wrap {
  width: 124rpx;
  height: 124rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.biz-icon--green {
  background: linear-gradient(135deg, #eaf3fb, #d7e9f8);
}

.biz-icon--blue {
  background: linear-gradient(135deg, #d7e9f8, #b8d4ef);
}

.biz-icon--orange {
  background: linear-gradient(135deg, #eaf3fb, #c7ddf2);
}

.biz-icon-text {
  font-size: 40rpx;
}

.biz-icon-img {
  width: 100%;
  height: 100%;
  display: block;
}

.biz-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.biz-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.biz-desc {
  font-size: 22rpx;
  color: var(--text-main);
  line-height: 1.7;
}

/* ========== Core Advantages ========== */
.adv-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #ffffff 0%, #f7fbfe 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(48, 117, 184, 0.06);
  border: 1rpx solid rgba(48, 117, 184, 0.08);
}

.adv-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 8rpx;
  background: linear-gradient(90deg, var(--green-primary), rgba(48, 117, 184, 0.18));
}

.adv-head {
  margin-bottom: 28rpx;
}

.adv-kicker {
  font-size: 20rpx;
  color: var(--green-primary);
  letter-spacing: 6rpx;
  margin-bottom: 10rpx;
}

.adv-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: 2rpx;
}

.adv-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.adv-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 22rpx;
  background: rgba(234, 243, 251, 0.62);
  border-radius: 22rpx;
}

.adv-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--green-primary), #5a9bd1);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(48, 117, 184, 0.16);
}

.adv-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--text-main);
}

.adv-strong {
  color: var(--green-primary);
  font-weight: 700;
}

/* ========== 服务流程 ========== */
.flow-list {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.flow-item {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(48, 117, 184, 0.05);
}

.flow-num {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--green-primary), var(--green-dark));
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.flow-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-top: 4rpx;
}

.flow-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

.flow-desc {
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.6;
}

.flow-connector {
  width: 4rpx;
  height: 24rpx;
  background: linear-gradient(to bottom, var(--green-primary), rgba(48, 117, 184, 0.15));
  margin-left: 58rpx;
  border-radius: 2rpx;
}

/* ========== Quote ========== */
.cta-section {
  padding-top: 32rpx;
}

.quote-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  padding: 56rpx 40rpx 52rpx;
  background: linear-gradient(145deg, #f8fbfe 0%, #eef5fb 100%);
  box-shadow: 0 12rpx 32rpx rgba(48, 117, 184, 0.08);
}

.quote-card::before {
  content: '';
  position: absolute;
  inset: 2rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(48, 117, 184, 0.12);
}

.quote-mark {
  position: absolute;
  font-size: 96rpx;
  line-height: 1;
  color: rgba(48, 117, 184, 0.18);
  font-weight: 700;
  z-index: 1;
}

.quote-mark--left {
  top: 18rpx;
  left: 24rpx;
}

.quote-mark--right {
  right: 24rpx;
  bottom: 8rpx;
}

.quote-text {
  position: relative;
  z-index: 2;
  display: block;
  font-size: 28rpx;
  line-height: 1.95;
  color: var(--text-main);
  text-align: center;
  letter-spacing: 1rpx;
}

.quote-glow {
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  right: -60rpx;
  top: -70rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(184, 212, 239, 0.38) 0%, rgba(184, 212, 239, 0) 72%);
}

/* ========== Footer ========== */
.footer {
  padding: 44rpx 40rpx 24rpx;
  text-align: center;
}

.footer-text {
  font-size: 20rpx;
  color: var(--text-light);
  letter-spacing: 2rpx;
}
