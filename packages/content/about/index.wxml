<view class="about-page">

  <!-- Hero -->
  <view class="hero">
    <view class="hero-bg"></view>
    <view class="hero-deco hero-deco-1"></view>
    <view class="hero-deco hero-deco-2"></view>
    <view class="hero-deco hero-deco-3"></view>
    <view class="hero-content">
      <view class="hero-tag">ABOUT US</view>
      <view class="hero-title">蓝点荟</view>
      <view class="hero-sub">家庭健康管理专家</view>
    </view>
  </view>

  <!-- 企业介绍 -->
  <view class="section">
    <view class="sec-header">
      <view class="sec-line"></view>
      <text class="sec-title">企业简介</text>
      <view class="sec-line"></view>
    </view>
    <view class="card intro-card">
      <text class="card-text">蓝点荟大健康管理（上海）有限公司是国内领先的科技驱动型健康管理整合平台，致力于通过"检测-干预-管理"全流程闭环，为客户提供全生命周期的精准健康管理服务。平台以肠道微生态调控和心血管早筛为核心切入点，整合全球优质健康科技资源，构建覆盖预防、诊断、干预的一站式解决方案。</text>
      <!-- <text class="card-text" style="margin-top: 16rpx;">围绕肠道菌群检测、报告解读、益生菌产品和会员健康管理，蓝点荟希望为用户建立长期可追踪的肠道健康档案，让每一次选择都有数据依据。</text> -->
    </view>
  </view>

  <!-- 核心业务 -->
  <view class="section">
    <view class="sec-header">
      <view class="sec-line"></view>
      <text class="sec-title">核心业务</text>
      <view class="sec-line"></view>
    </view>

    <!-- 业务1: 益生菌干预 -->
    <view class="biz-card">
      <view class="biz-icon-wrap biz-icon--green">
        <image wx:if="{{aboutIcons.icon1}}" class="biz-icon-img" src="{{aboutIcons.icon1}}" mode="aspectFit" />
      </view>
      <view class="biz-body">
        <text class="biz-name">微生态健康管理</text>
        <text class="biz-desc">精选国际认证复合益生菌配方，联合权威医疗机构开展肠道菌群移植（FMT）服务，针对肠脑轴失衡、代谢综合征等提供个性化干预方案。  </text>
      </view>
    </view>

    <!-- 业务2: 肠道菌群检测 -->
    <view class="biz-card">
      <view class="biz-icon-wrap biz-icon--blue">
        <image wx:if="{{aboutIcons.icon2}}" class="biz-icon-img" src="{{aboutIcons.icon2}}" mode="aspectFit" />
      </view>
      <view class="biz-body">
        <text class="biz-name">心血管风险管理</text>
        <text class="biz-desc">整合国际先进sdLDL检测技术，通过捕捉致动脉粥样硬化关键颗粒，实现冠心病风险超前预警。</text>
      </view>
    </view>

    <!-- 业务3: 高端健康体检 -->
    <view class="biz-card">
      <view class="biz-icon-wrap biz-icon--orange">
        <image wx:if="{{aboutIcons.icon3}}" class="biz-icon-img" src="{{aboutIcons.icon3}}" mode="aspectFit" />
      </view>
      <view class="biz-body">
        <text class="biz-name">高端健康体检  </text>
        <text class="biz-desc"> 联合三甲医院及专业体检中心，提供包含肿瘤早筛、基因检测等在内的定制化体检套餐。</text>
      </view>
    </view>
    <!-- 业务4: 健康管理 -->
    <view class="biz-card">
      <view class="biz-icon-wrap biz-icon--orange">
        <image wx:if="{{aboutIcons.icon4}}" class="biz-icon-img" src="{{aboutIcons.icon4}}" mode="aspectFit" />
      </view>
      <view class="biz-body">
        <text class="biz-name"> 智能健康管理</text>
        <text class="biz-desc"> 基于AI健康管理系统，动态追踪300+健康指标，生成个性化健康改善方案。</text>
      </view>
    </view>
  </view>

  <!-- 平台核心优势 -->
  <view class="section">
    <view class="sec-header">
      <view class="sec-line"></view>
      <text class="sec-title">核心优势</text>
      <view class="sec-line"></view>
    </view>
    <view class="adv-card">
      <view class="adv-head">
        <view class="adv-kicker">ADVANTAGES</view>
        <text class="adv-title">平台核心优势</text>
      </view>
      <view class="adv-list">
        <view class="adv-item">
          <view class="adv-icon">▶</view>
          <text class="adv-text">严选全球顶尖健康科技产品与服务</text>
        </view>
        <view class="adv-item">
          <view class="adv-icon">▶</view>
          <text class="adv-text">覆盖 <text class="adv-strong">200万+</text> 样本的健康数据库支持</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 品牌引言 -->
  <view class="section cta-section">
    <view class="quote-card">
      <view class="quote-mark quote-mark--left">“</view>
      <text class="quote-text">蓝点荟通过整合全球优质健康资源，打造从精准检测到科学干预的完整服务链条，重新定义现代健康管理服务标准。</text>
      <view class="quote-mark quote-mark--right">”</view>
      <view class="quote-glow"></view>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">蓝点荟 © 家庭健康管理专家</text>
  </view>
</view>
