page {
  background: #f8faf5;
  --green-primary: #3075B8;
  --green-dark: #245F99;
  --text-main: #2d3a2e;
  --text-sub: #7a8a7c;
  --text-light: #a3b5a6;
  /* stepper 数量选择器 */
  --td-stepper-input-bg-color: #F5FAFF;
  --td-stepper-input-font-color: #2d3a2e;
  --td-stepper-normal-bg-color: #F5FAFF;
  --td-stepper-hover-bg-color: #EAF3FB;
  /* dialog 弹窗 */
  --td-dialog-confirm-btn-color: #3075B8;
  --td-dialog-border-radius: 24rpx;
  --td-dialog-header-color: #2d3a2e;
  --td-dialog-body-color: #6f7f71;
}

:host {
  padding-bottom: 100rpx;
}

.gap {
  height: 100rpx;
  width: 100%;
}

.t-button {
  --td-button-default-color: #2d3a2e;
  --td-button-primary-text-color: #3075B8;
}

.cart-delete-dialog {
  --td-dialog-bg-color: #ffffff;
}

.cart-delete-dialog .t-dialog__footer {
  align-items: center;
  justify-content: center;
}

.cart-delete-dialog__confirm {
  color: #ffffff !important;
  background: linear-gradient(135deg, #3075B8, #245F99) !important;
  border-radius: 999rpx !important;
  font-weight: 600;
  border: none !important;
  box-shadow: 0 8rpx 24rpx rgba(48, 117, 184, 0.22);
  width: 216rpx !important;
  height: 76rpx !important;
  line-height: 76rpx !important;
  flex: 0 0 216rpx !important;
  margin: 0 16rpx 24rpx 8rpx !important;
  font-size: 30rpx !important;
}

.cart-delete-dialog__cancel {
  color: #3075B8 !important;
  background: #F5FAFF !important;
  border-radius: 999rpx !important;
  border: 2rpx solid #D7E9F7 !important;
  font-weight: 600;
  width: 216rpx !important;
  height: 76rpx !important;
  line-height: 76rpx !important;
  flex: 0 0 216rpx !important;
  margin: 0 8rpx 24rpx 16rpx !important;
  font-size: 30rpx !important;
}
