.cart-bar__placeholder {
  height: 100rpx;
}
.flex {
  display: flex;
}
.flex-v-center {
  align-items: center;
}
.flex1 {
  flex: 1;
}
.algin-bottom {
  text-align: end;
}
.cart-bar--fixed {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 99;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.cart-bar {
  height: 112rpx;
  background-color: #ffffff;
  border-top: 1rpx solid rgba(48, 117, 184, 0.12);
  padding: 16rpx 32rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #2d3a2e;
}

.cart-bar .cart-bar__check {
  margin-right: 12rpx;
}

.cart-bar .cart-bar__total {
  margin-left: 24rpx;
}

.cart-bar .account-btn {
  width: 192rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #3075B8 0%, #245F99 100%);
  font-size: 28rpx;
  font-weight: bold;
  line-height: 80rpx;
  color: #ffffff;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(48, 117, 184, 0.25);
}
.cart-bar .disabled-btn {
  background: #B8D4EF !important;
  box-shadow: none !important;
}
.cart-bar .hover-btn {
  opacity: 0.8;
}

.cart-bar__total .cart-bar__total--bold {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #2d3a2e;
  font-weight: bold;
}
.cart-bar__total .cart-bar__total--normal {
  font-size: 24rpx;
  line-height: 32rpx;
  color: #a3b5a6;
}

.cart-bar__total .cart-bar__total--price {
  color: #3075B8;
  font-weight: bold;
}

.text-padding-right {
  padding-right: 4rpx;
}