.cart-empty {
  padding: 120rpx 0rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  height: calc(100vh - 100rpx);
  background-color: #f8faf5;
}
.cart-empty .cart-img {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.cart-empty .tip {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #a3b5a6;
  margin-bottom: 36rpx;
}
.cart-empty .btn {
  width: 260rpx;
  height: 76rpx;
  border-radius: 38rpx;
  text-align: center;
  line-height: 76rpx;
  border: none;
  color: #ffffff;
  background: linear-gradient(135deg, #5aaa6e 0%, #198f3d 100%);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 16rpx rgba(90, 170, 110, 0.25);
}