<view class="result-container">
  <t-search
    t-class="result-search"
    t-class-input-container="result-search-input-wrap"
    t-class-left="result-search-left-icon"
    t-class-input="result-search-input"
    value="{{keywords}}"
    leftIcon=""
    placeholder="搜索商品/服务"
    bind:change="handleInput"
    bind:submit="handleSubmit"
  >
    <t-icon slot="left-icon" prefix="wr" name="search" size="40rpx" color="#9aa6a0" />
  </t-search>

  <view class="loading-wrap" wx:if="{{loading}}">
    <t-loading theme="circular" size="40rpx" text="搜索中..." inherit-color />
  </view>

  <view class="empty-wrap" wx:elif="{{goodsList.length === 0 && hasLoaded}}">
    <t-empty t-class="empty-tips" size="220rpx" description="暂无相关商品" />
  </view>

  <view class="search-result-list" wx:else>
    <view class="search-result-card" wx:for="{{goodsList}}" wx:key="spuId" data-id="{{item.spuId}}" bind:tap="goDetail">
      <image class="search-result-thumb" src="{{item.thumb}}" mode="aspectFill" />
      <view class="search-result-info">
        <view class="search-result-title-row">
          <text class="search-result-title">{{item.title}}</text>
          <text class="search-result-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
        </view>
        <text class="search-result-brief">{{item.brief}}</text>
        <view class="search-result-bottom">
          <view class="search-result-price">
            <text class="search-result-symbol">¥</text>
            <text class="search-result-price-num">{{item.price}}</text>
          </view>
          <text class="search-result-action">查看详情</text>
        </view>
      </view>
    </view>
  </view>
</view>
<t-toast id="t-toast" />
