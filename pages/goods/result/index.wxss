page {
  background: #f7faf6;
}

page view {
  box-sizing: border-box;
}

.result-container {
  min-height: 100vh;
  padding: 18rpx 28rpx 48rpx;
}

.result-search {
  padding: 0 !important;
  background: transparent !important;
}

.result-search-input-wrap {
  height: 72rpx !important;
  border-radius: 999rpx !important;
  background: #ffffff !important;
  border: none !important;
}

.result-search-left-icon {
  display: flex;
  align-items: center;
}

.result-search-input {
  color: #26352b !important;
  font-size: 28rpx !important;
}

.loading-wrap {
  height: 50vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8ba092;
}

.empty-wrap {
  padding-top: 160rpx;
}

.search-result-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.search-result-card {
  display: flex;
  gap: 22rpx;
  min-height: 196rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(67, 113, 77, 0.08);
}

.search-result-card:active {
  opacity: 0.9;
}

.search-result-thumb {
  width: 156rpx;
  height: 156rpx;
  border-radius: 16rpx;
  background: #edf5ee;
  flex-shrink: 0;
}

.search-result-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.search-result-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.search-result-title {
  color: #26352b;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.search-result-badge {
  flex-shrink: 0;
  max-width: 128rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #3d8b4f;
  background: #e8f5e9;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-result-brief {
  margin-top: 10rpx;
  color: #7c8d80;
  font-size: 23rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.search-result-bottom {
  margin-top: auto;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.search-result-price {
  display: flex;
  align-items: baseline;
  color: #2f8a4c;
}

.search-result-symbol {
  font-size: 22rpx;
  font-weight: 600;
}

.search-result-price-num {
  font-size: 36rpx;
  font-weight: 700;
}

.search-result-action {
  color: #5aaa6e;
  font-size: 22rpx;
  white-space: nowrap;
}
