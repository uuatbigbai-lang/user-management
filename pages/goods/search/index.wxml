<view class="search-page">
  <view class="search-hero">
    <t-search
      t-class="search-control"
      t-class-input-container="t-class__input-container"
      t-class-input="t-search__input"
      value="{{searchValue}}"
      leftIcon=""
      placeholder="搜索商品/服务"
      bind:change="handleInput"
      bind:submit="handleSubmit"
      focus
    >
      <t-icon slot="left-icon" prefix="wr" name="search" size="40rpx" color="#7f9287" />
    </t-search>
  </view>
  <view class="search-wrap" wx:if="{{!hasSearched}}">
    <view class="history-wrap">
      <view class="search-header">
        <text class="search-title">历史搜索</text>
        <text class="search-clear" bind:tap="handleClearHistory">清除</text>
      </view>
      <view class="search-content" wx:if="{{historyWords.length}}">
        <view
          class="search-item"
          hover-class="hover-history-item"
          wx:for="{{historyWords}}"
          bind:tap="handleHistoryTap"
          bindlongpress="deleteCurr"
          data-index="{{index}}"
          wx:key="*this"
        >
          {{item}}
        </view>
      </view>
      <view class="search-empty" wx:else>暂无历史搜索</view>
    </view>
    <view class="popular-wrap">
      <view class="search-header">
        <text class="search-title">热门搜索</text>
      </view>
      <view class="search-content">
        <view
          class="search-item"
          hover-class="hover-history-item"
          wx:for="{{popularWords}}"
          bind:tap="handlePopularTap"
          data-index="{{index}}"
          wx:key="*this"
        >
          {{item}}
        </view>
      </view>
    </view>
  </view>
  <view class="loading-wrap" wx:elif="{{loading}}">
    <t-loading theme="circular" size="40rpx" text="搜索中..." inherit-color />
  </view>
  <view class="result-empty" wx:elif="{{goodsList.length === 0}}">
    <t-empty t-class="empty-tips" size="220rpx" description="暂无相关商品" />
  </view>
  <view class="search-result-list" wx:else>
    <view class="search-result-card" wx:for="{{goodsList}}" wx:key="spuId" data-id="{{item.spuId}}" bind:tap="goDetail">
      <image class="search-result-thumb" src="{{item.thumb}}" mode="aspectFill" />
      <view class="search-result-info">
        <view class="search-result-title-row">
          <text class="search-result-title">{{item.title}}</text>
          <text class="search-result-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
        </view>
        <text class="search-result-brief">{{item.brief}}</text>
        <view class="search-result-bottom">
          <view class="search-result-price">
            <text class="search-result-symbol">¥</text>
            <text class="search-result-price-num">{{item.price}}</text>
          </view>
          <text class="search-result-action">查看详情</text>
        </view>
      </view>
    </view>
  </view>
  <t-dialog
    visible="{{dialogShow}}"
    content="{{dialog.message}}"
    bindconfirm="confirm"
    bind:close="close"
    confirm-btn="确定"
    cancel-btn="{{dialog.showCancelButton ? '取消' : null}}"
    t-class-confirm="dialog__button-confirm"
    t-class-cancel="dialog__button-cancel"
  />
  <t-toast id="t-toast" />
</view>
