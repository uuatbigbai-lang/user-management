page {
  background: #f7faf6;
}

page view {
  box-sizing: border-box;
}

.search-page {
  width: 100vw;
  min-height: 100vh;
  padding: 0 30rpx 56rpx;
}

.search-hero {
  margin: 0 -30rpx;
  padding: 32rpx 30rpx 24rpx;
  background: #f7faf6;
}

.search-page .search-control {
  padding: 0 !important;
  background: transparent !important;
}

.search-page .t-class__input-container {
  height: 76rpx !important;
  border-radius: 999rpx !important;
  background: #ffffff !important;
  border: none !important;
  box-shadow: 0 10rpx 28rpx rgba(58, 112, 70, 0.1);
}

.search-page .t-search__input {
  font-size: 28rpx !important;
  color: #24362b !important;
}

.search-page .search-wrap {
  margin-top: 32rpx;
}

.search-page .history-wrap,
.search-page .popular-wrap {
  margin-bottom: 44rpx;
}

.search-page .search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.search-page .search-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #24362b;
  line-height: 42rpx;
}

.search-page .search-clear {
  font-size: 24rpx;
  line-height: 32rpx;
  color: #7f9287;
}

.search-page .search-clear:active {
  opacity: 0.72;
}

.search-page .search-content {
  display: flex;
  flex-flow: row wrap;
  align-items: flex-start;
  margin-top: 24rpx;
}

.search-page .search-item {
  color: #31533d;
  font-size: 25rpx;
  line-height: 34rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 14rpx 26rpx;
  box-shadow: 0 6rpx 18rpx rgba(58, 112, 70, 0.06);
}

.search-page .hover-history-item {
  opacity: 0.78;
}

.search-empty {
  margin-top: 24rpx;
  padding: 28rpx 0;
  color: #9eaca3;
  font-size: 24rpx;
}

.add-notes__confirm {
  color: #245F99 !important;
}

.loading-wrap {
  height: 48vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8ba092;
}

.result-empty {
  padding-top: 150rpx;
}

.search-result-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 28rpx;
}

.search-result-card {
  display: flex;
  gap: 22rpx;
  min-height: 196rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(67, 113, 77, 0.08);
}

.search-result-card:active {
  opacity: 0.9;
}

.search-result-thumb {
  width: 156rpx;
  height: 156rpx;
  border-radius: 16rpx;
  background: #edf5ee;
  flex-shrink: 0;
}

.search-result-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.search-result-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.search-result-title {
  color: #26352b;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.search-result-badge {
  flex-shrink: 0;
  max-width: 128rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #245F99;
  background: #EAF3FB;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-result-brief {
  margin-top: 10rpx;
  color: #7c8d80;
  font-size: 23rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.search-result-bottom {
  margin-top: auto;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.search-result-price {
  display: flex;
  align-items: baseline;
  color: #245F99;
}

.search-result-symbol {
  font-size: 22rpx;
  font-weight: 600;
}

.search-result-price-num {
  font-size: 36rpx;
  font-weight: 700;
}

.search-result-action {
  color: #3075B8;
  font-size: 22rpx;
  white-space: nowrap;
}
