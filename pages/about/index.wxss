page {
  background: #f8faf5;
  --green-primary: #5aaa6e;
  --green-dark: #3d8b4f;
  --text-main: #2d3a2e;
  --text-sub: #7a8a7c;
  --text-light: #a3b5a6;
}

.about-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ========== Hero ========== */
.hero {
  position: relative;
  padding: 72rpx 48rpx 56rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: -60rpx -40rpx -40rpx;
  background: linear-gradient(160deg, #e8f5e9 0%, #c8e6c9 35%, #a5d6a7 65%, #e8f5e9 100%);
  border-radius: 0 0 56rpx 56rpx;
  z-index: 0;
}

.hero-deco {
  position: absolute;
  border-radius: 50%;
  z-index: 0;
}

.hero-deco-1 {
  width: 260rpx;
  height: 260rpx;
  top: -50rpx;
  right: -30rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.4) 0%, transparent 70%);
}

.hero-deco-2 {
  width: 140rpx;
  height: 140rpx;
  bottom: 10rpx;
  left: 20rpx;
  border: 2rpx solid rgba(255,255,255,0.3);
}

.hero-deco-3 {
  width: 80rpx;
  height: 80rpx;
  top: 60rpx;
  right: 160rpx;
  background: rgba(255,255,255,0.2);
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-tag {
  font-size: 20rpx;
  color: var(--green-primary);
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.hero-sub {
  font-size: 26rpx;
  color: var(--green-dark);
  letter-spacing: 2rpx;
}

/* ========== Section ========== */
.section {
  padding: 44rpx 40rpx 0;
}

.sec-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.sec-line {
  width: 48rpx;
  height: 2rpx;
  background: var(--green-primary);
  opacity: 0.35;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin: 0 20rpx;
  letter-spacing: 4rpx;
}

/* ========== Card ========== */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(90,170,110,0.06);
}

.card-text {
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.9;
  display: block;
}

/* ========== 核心业务 ========== */
.biz-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(90,170,110,0.06);
}

.biz-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.biz-icon--green {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
}

.biz-icon--blue {
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
}

.biz-icon--orange {
  background: linear-gradient(135deg, #fff3e0, #ffe0b2);
}

.biz-icon-text {
  font-size: 40rpx;
}

.biz-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.biz-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.biz-desc {
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.7;
}

/* ========== 实验室 ========== */
.lab-badges {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.lab-badge {
  font-size: 20rpx;
  color: var(--green-dark);
  background: #e8f5e9;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.lab-highlights {
  display: flex;
  justify-content: space-around;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(90,170,110,0.1);
}

.lab-hl-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lab-hl-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--green-primary);
  margin-bottom: 4rpx;
}

.lab-hl-label {
  font-size: 20rpx;
  color: var(--text-light);
}

/* ========== 服务流程 ========== */
.flow-list {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.flow-item {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(90,170,110,0.05);
}

.flow-num {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--green-primary), var(--green-dark));
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.flow-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-top: 4rpx;
}

.flow-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

.flow-desc {
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.6;
}

.flow-connector {
  width: 4rpx;
  height: 24rpx;
  background: linear-gradient(to bottom, var(--green-primary), rgba(90,170,110,0.15));
  margin-left: 58rpx;
  border-radius: 2rpx;
}

/* ========== CTA ========== */
.cta-section {
  padding-top: 32rpx;
}

.cta-card {
  background: linear-gradient(160deg, #e8f5e9 0%, #c8e6c9 50%, #a5d6a7 100%);
  border-radius: 28rpx;
  padding: 48rpx 36rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.cta-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.cta-desc {
  font-size: 24rpx;
  color: var(--green-dark);
  margin-bottom: 36rpx;
}

.cta-btns {
  display: flex;
  gap: 24rpx;
}

.cta-btn {
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.cta-btn--primary {
  background: linear-gradient(135deg, var(--green-primary), var(--green-dark));
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(90,170,110,0.3);
}

.cta-btn--primary:active {
  opacity: 0.85;
}

.cta-btn--outline {
  background: rgba(255,255,255,0.75);
  color: var(--green-dark);
  border: 1rpx solid rgba(90,170,110,0.25);
}

.cta-btn--outline:active {
  background: rgba(255,255,255,0.95);
}

/* ========== Footer ========== */
.footer {
  padding: 44rpx 40rpx 24rpx;
  text-align: center;
}

.footer-text {
  font-size: 20rpx;
  color: var(--text-light);
  letter-spacing: 2rpx;
}