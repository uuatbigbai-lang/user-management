<view class="success-container">
  <!-- 背景装饰 -->
  <view class="background-decoration">
    <view class="decoration-circle circle-1"></view>
    <view class="decoration-circle circle-2"></view>
    <view class="decoration-circle circle-3"></view>
    <view class="decoration-circle circle-4"></view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <t-loading theme="circular" size="60rpx" />
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 主要内容 -->
  <view wx:else class="main-content">
    <!-- 成功图标区域 -->
    <view class="success-icon-section {{showAnimation ? 'show' : ''}}">
      <!-- 外圆环 -->
      <view class="success-circle-outer">
        <view class="success-circle-middle">
          <view class="success-circle-inner">
            <!-- PNG 对勾图标 -->
            <view class="checkmark-container">
              <image 
                class="checkmark-image" 
                src="https://i.postimg.cc/PrcY81rN/success.png"
                mode="aspectFit"
              ></image>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 成功文字 -->
      <view class="success-title">
        {{pageConfig.messages.success || '签到成功！'}}
      </view>
    </view>

    <!-- 详细信息区域 -->
    <view class="info-section {{showAnimation ? 'show' : ''}}">
      <view class="info-card">
        <view class="info-header">
          <view class="info-title">{{pageConfig.pageInfo.title || '签到'}}</view>
          <view class="info-subtitle">{{pageConfig.pageInfo.subtitle || '记录美好时光'}}</view>
        </view>
      </view>
    </view>

    

    <!-- 鼓励文字区域 -->
    <view class="encouragement-section {{showAnimation ? 'show' : ''}}">
      <view class="encouragement-text">
        <text class="encouragement-main">{{pageConfig.pageInfo.txt1 || '🎉 恭喜完成今日签到！'}}</text>
        <text class="encouragement-sub">{{pageConfig.pageInfo.txt2 || '坚持每日签到，养成良好习惯'}}</text>
      </view>
    </view>

    <!-- 底部装饰 -->
    <view class="bottom-decoration">
      <view class="sparkle sparkle-1">✨</view>
      <view class="sparkle sparkle-2">⭐</view>
      <view class="sparkle sparkle-3">💫</view>
      <view class="sparkle sparkle-4">🌟</view>
    </view>

    <!-- 底部品牌信息 -->
    <view class="brand-section {{showAnimation ? 'show' : ''}}">
      <view class="progress-decoration">
        <view class="progress-dots">
          <view class="dot active"></view>
          <view class="dot active"></view>
          <view class="dot active"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
        <text class="progress-text">®️蓝点荟</text>
      </view>
    </view>
  </view>
</view>