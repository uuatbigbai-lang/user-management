:host {
  background-color: #f5f5f5;
}
.page-container .tab-bar__placeholder,
.page-container .tab-bar__inner {
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
}
.page-container .tab-bar__inner {
  font-size: 26rpx;
  color: #333333;
  position: fixed;
  width: 100vw;
  top: 0;
  left: 0;
}
.page-container .tab-bar__inner.order-nav .order-nav-item .bottom-line {
  bottom: 12rpx;
}
.tab-bar__inner .t-tabs-is-active {
  color: #3075B8 !important;
}

.tab-bar__inner .t-tabs-track {
  background: #3075B8 !important;
}

.page-container .tab-bar__active {
  font-size: 28rpx;
}
.page-container .specs-popup .bottom-btn {
  color: #3075B8;
  color: var(--color-primary, #3075B8);
}
.page-container .specs-popup .bottom-btn::after {
  border-color: #3075B8;
  border-color: var(--color-primary, #3075B8);
}
.dialog .dialog__button-confirm {
  color: #3075B8;
  color: var(--color-primary, #3075B8);
}
.list-loading {
  height: 100rpx;
}
.empty-wrapper {
  height: calc(100vh - 88rpx);
}

.empty-state {
  min-height: calc(100vh - 88rpx);
  box-sizing: border-box;
  padding: 160rpx 56rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: #f5f5f5;
}

.empty-state__image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 20rpx;
}

.empty-state__title {
  color: #1f2a24;
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 600;
}

.empty-state__desc {
  width: 520rpx;
  margin-top: 12rpx;
  color: #8a938d;
  font-size: 26rpx;
  line-height: 38rpx;
}

.empty-state__button {
  width: 240rpx;
  height: 72rpx;
  margin-top: 44rpx;
  padding: 0;
  border-radius: 36rpx;
  background: #3075B8;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 72rpx;
  font-weight: 500;
}

.empty-state__button::after {
  display: none;
}

.empty-state__button:active {
  background: #266a38;
}

.btn-bar {
  margin-top: 20rpx;
}
.load-more {
  margin: 0 24rpx;
}
wr-order-goods-card:not(:first-child) .wr-goods-card {
  margin-top: 40rpx;
}

.price-total {
  font-size: 24rpx;
  line-height: 32rpx;
  color: #999999;
  padding-top: 10rpx;
  width: 100%;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
}
.price-total .bold-price {
  color: #333333;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333333;
}
.price-total .real-pay {
  font-size: 36rpx;
  line-height: 48rpx;
  color: #3075B8;
  font-weight: bold;
}

.t-tabs.t-tabs--top .t-tabs-scroll {
  border: none !important;
}
.t-empty-text {
  font-size: 28rpx;
  color: #999;
}

.page-container .order-number {
  color: #666666;
  font-size: 28rpx;
}

.page-container .order-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.page-container .order-card-header .order-number {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.page-container .order-status {
  flex-shrink: 0;
  margin-left: 24rpx;
  color: #3075B8;
  font-size: 26rpx;
  line-height: 40rpx;
  font-weight: 500;
}
.t-class-indicator {
  color: #b9b9b9 !important;
}
.tab-bar .tab-bar__active {
  color: #333333 !important;
}

.tab-bar .t-tabs-track {
  background: #333333 !important;
}

.t-button {
  --td-button-default-color: #000;
  --td-button-primary-text-color: #3075B8;
}
