.order-sure {
  box-sizing: border-box;
  background: #f8faf5;
  padding: 24rpx 0 calc(env(safe-area-inset-bottom) + 136rpx);
  min-height: 100vh;
  --green-primary: #3075B8;
  --green-dark: #245F99;
  --green-light: #EAF3FB;
  --text-main: #2d3a2e;
  --text-sub: #7a8a7c;
}

.order-sure .wx-pay-cover {
  position: fixed;
  left: 0;
  bottom: 0;
  right: 0;
  z-index: 10;
  background: #fff;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.order-sure .wx-pay-cover .wx-pay {
  width: 100%;
  height: 100rpx;
  box-sizing: border-box;
  padding: 0rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.order-sure .wx-pay-cover .wx-pay .price {
  color: var(--green-primary);
  font-weight: bold;
  font-size: 63rpx;
  line-height: 88rpx;
}

.order-sure .wx-pay-cover .wx-pay .submit-btn {
  height: 80rpx;
  width: 240rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, var(--green-primary), var(--green-dark));
  color: #ffffff;
  line-height: 80rpx;
  font-weight: bold;
  font-size: 28rpx;
  text-align: center;
}
.order-sure .wx-pay-cover .wx-pay .btn-gray {
  background: #cccccc;
}

.order-wrapper .store-wrapper {
  width: 100%;
  height: 96rpx;
  box-sizing: border-box;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  line-height: 40rpx;
  color: var(--text-main);
  background-color: #ffffff;
}
.order-wrapper .store-wrapper .store-logo {
  margin-right: 16rpx;
}
.order-wrapper .goods-wrapper {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-sub);
  background-color: #ffffff;
}
.goods-wrapper .goods-image {
  width: 176rpx;
  height: 176rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 16rpx;
}
.goods-wrapper .goods-content {
  flex: 1;
}

.goods-wrapper .goods-content .goods-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 28rpx;
  line-height: 40rpx;
  margin-bottom: 12rpx;
  color: var(--text-main);
  margin-right: 16rpx;
}

.goods-wrapper .goods-right {
  min-width: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.goods-right .goods-price {
  color: var(--green-primary);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.goods-right .goods-num {
  text-align: right;
  color: var(--text-sub);
}

.order-sure .pay-detail {
  background-color: #ffffff;
  padding: 16rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.order-sure .order-mode {
  margin: 0 24rpx 24rpx;
  padding: 10rpx;
  border-radius: 28rpx;
  background: #ffffff;
  display: flex;
  box-shadow: 0 12rpx 32rpx rgba(48, 117, 184, 0.08);
}

.order-sure .order-mode__item {
  flex: 1;
  height: 76rpx;
  border-radius: 20rpx;
  color: var(--text-sub);
  font-size: 28rpx;
  line-height: 76rpx;
  text-align: center;
  font-weight: 600;
}

.order-sure .order-mode__item--active {
  background: linear-gradient(135deg, var(--green-primary), var(--green-dark));
  color: #ffffff;
}

.order-sure .delivery-tip {
  margin: 0 24rpx 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff, #f4f9ff);
  box-shadow: 0 12rpx 32rpx rgba(48, 117, 184, 0.08);
}

.order-sure .delivery-tip__title {
  color: var(--text-main);
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: bold;
}

.order-sure .delivery-tip__desc {
  margin-top: 8rpx;
  color: var(--text-sub);
  font-size: 24rpx;
  line-height: 36rpx;
}

.order-sure .pay-detail .pay-item {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--text-sub);
}
.order-sure .pay-detail .pay-item .pay-item__right {
  color: var(--text-main);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  max-width: 400rpx;
}
.order-sure .pay-detail .pay-item .pay-item__right .coupon-name {
  color: var(--text-sub);
  margin-right: 8rpx;
}
.order-sure .pay-detail .pay-item .pay-item__right .pay-remark {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  max-width: 400rpx;
  text-overflow: ellipsis;
  overflow: hidden;
}
.order-sure .pay-detail .pay-item .font-bold {
  font-weight: bold;
}
.order-sure .pay-detail .pay-item .primary {
  color: var(--green-primary);
}

.add-notes .add-notes__content {
  --td-textarea-background-color: #f5f5f5;
}

.add-notes .t-textarea__placeholder {
  color: #aeb3b7;
}

.add-notes .add-notes__textarea__font {
  font-size: 26rpx;
}
.add-notes .add-notes__textarea {
  margin-top: 32rpx;
}

.order-sure .add-notes .dialog__message {
  border-radius: 8rpx;
}

.order-sure .add-notes .dialog__button-cancel::after {
  border-right: 0;
}

.order-sure .amount-wrapper {
  width: 100%;
  box-sizing: border-box;
  background-color: #ffffff;
  padding: 0rpx 32rpx;
  height: 96rpx;
}

.order-sure .pay-amount {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: var(--text-main);
  position: relative;
}
.order-sure .pay-amount::after {
  position: absolute;
  content: ' ';
  top: 0;
  left: 0;
  width: 200%;
  height: 200%;
  transform: scale(0.5);
  transform-origin: 0 0;
  border-top: 2rpx solid #EAF3FB;
}
.order-sure .pay-amount .order-num {
  color: var(--text-sub);
  padding-right: 8rpx;
}

.order-sure .pay-amount .total-price {
  font-size: 36rpx;
  color: var(--green-primary);
  font-weight: bold;
  padding-left: 8rpx;
}
