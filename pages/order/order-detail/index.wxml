<t-pull-down-refresh
  id="t-pull-down-refresh"
  value="{{pullDownRefreshing}}"
  bindchange="onPullDownRefreshChange"
  bindrefresh="onPullDownRefresh_"
  t-class-indicator="t-class-indicator"
>
  <!-- 页面内容 -->
  <view class="order-detail">
    <view class="header">
      <view class="order-detail__header">
        <view class="title">{{_order.statusDesc}}</view>
        <view class="desc">
          <block wx:if="{{ order.holdStatus === 1 }}">
            <block wx:if="{{ order.groupInfoVo.residueTime > 0 }}">
              拼团剩余
              <t-count-down
                time="{{order.groupInfoVo.residueTime}}"
                format="HH小时mm分ss秒"
                t-class="count-down"
                bindfinish="onCountDownFinish"
              />
              <view>过时自动取消</view>
            </block>
          </block>
          <block wx:elif="{{countDownTime === null}}">{{order.orderStatusRemark || ''}}</block>
          <block wx:elif="{{countDownTime > 0}}">
            剩
            <t-count-down
              time="{{countDownTime}}"
              format="HH小时mm分ss秒"
              t-class="count-down"
              bindfinish="onCountDownFinish"
            />
            支付，过时订单将会取消
          </block>
          <block wx:else>超时未支付</block>
        </view>
      </view>

      <!-- 物流 -->
      <view class="order-logistics" wx:if="{{hasDeliveryInfo && logisticsNodes[0]}}" bindtap="onDeliveryClick">
        <t-icon name="deliver" size="40rpx" class="logistics-icon" prefix="wr" />
        <view class="logistics-content">
          <view>{{logisticsNodes[0].desc}}</view>
          <view class="logistics-time">{{logisticsNodes[0].date}}</view>
        </view>
        <t-icon class="logistics-back" name="arrow_forward" size="36rpx" prefix="wr" />
      </view>
      <view class="wechat-logistics" wx:if="{{showWechatLogisticsEntry}}" bindtap="onWechatLogisticsTap">
        <view class="wechat-logistics__icon">
          <t-icon name="deliver" size="36rpx" prefix="wr" />
        </view>
        <view class="wechat-logistics__content">
          <view class="wechat-logistics__title">微信物流查询</view>
          <view class="wechat-logistics__desc">
            <block wx:if="{{wechatLogistics.company || wechatLogistics.logisticsNo}}">
              {{wechatLogistics.company}}{{wechatLogistics.company && wechatLogistics.logisticsNo ? ' ' : ''}}{{wechatLogistics.logisticsNo}}
            </block>
            <block wx:else>{{wechatLogistics.statusText}}</block>
          </view>
        </view>
        <view class="wechat-logistics__status">{{wechatLogistics.statusText}}</view>
        <t-icon class="logistics-back" name="arrow_forward" size="36rpx" prefix="wr" />
      </view>
      <view class="border-bottom" wx:if="{{hasDeliveryInfo && logisticsNodes[0]}}" />
      <!-- 检测进度 -->
      <view class="sample-progress" wx:if="{{showSampleProgress}}">
        <view class="sample-progress__header">
          <view class="sample-progress__title">检测进度</view>
          <view class="sample-progress__status">{{sampleProgress.currentText}}</view>
        </view>
        <view class="sample-progress__steps">
          <view
            wx:for="{{sampleProgress.steps}}"
            wx:key="title"
            class="sample-progress__step {{item.done ? 'is-done' : ''}} {{item.active ? 'is-active' : ''}}"
          >
            <view class="sample-progress__node">
              <view class="sample-progress__dot"></view>
              <view wx:if="{{index < sampleProgress.steps.length - 1}}" class="sample-progress__line"></view>
            </view>
            <view class="sample-progress__text">
              <view class="sample-progress__name">{{item.title}}</view>
              <view class="sample-progress__desc">{{item.desc}}</view>
            </view>
          </view>
        </view>
      </view>
      <!-- 收货地址 -->
      <view class="order-logistics" wx:if="{{hasReceiverInfo}}">
        <t-icon name="location" size="40rpx" class="logistics-icon" prefix="wr" />
        <view class="logistics-content">
          <view>{{order.logisticsVO.receiverName}}{{order.logisticsVO.receiverName && order.logisticsVO.receiverPhone ? ' ' : ''}}{{order.logisticsVO.receiverPhone}}</view>
          <view class="logistics-time">{{_order.receiverAddress}}</view>
        </view>
        <view wx:if="{{addressEditable}}" class="edit-text" bindtap="onEditAddressTap"> 修改 </view>
      </view>
    </view>
    <!-- 店铺及商品 -->
    <order-card order="{{_order}}" use-top-right-slot>
      <order-goods-card
        wx:for="{{_order.goodsList}}"
        wx:key="id"
        wx:for-item="goods"
        wx:for-index="gIndex"
        goods="{{goods}}"
        no-top-line="{{gIndex === 0}}"
        bindtap="onGoodsCardTap"
        data-index="{{gIndex}}"
      >
        <order-button-bar
          slot="append-card"
          class="goods-button-bar"
          order="{{_order}}"
          bindrefresh="onRefresh"
          bindcontactservice="onContactServiceFromAfterSale"
          goodsIndex="{{gIndex}}"
        />
      </order-goods-card>
      <view class="pay-detail">
        <view class="pay-item">
          <text>商品总额</text>
          <price fill decimalSmaller wr-class="pay-item__right font-bold" price="{{order.totalAmount || '0'}}" />
        </view>
        <view class="pay-item">
          <text>运费</text>
          <view class="pay-item__right font-bold">
            <block wx:if="{{order.freightFee}}">
              +
              <price fill decimalSmaller price="{{order.freightFee}}" />
            </block>
            <text wx:else>免运费</text>
          </view>
        </view>
        <!-- <view class="pay-item">
          <text>活动优惠</text>
          <view class="pay-item__right primary font-bold">
            -
            <price fill price="{{order.discountAmount || 0}}" />
          </view>
        </view> -->
        <view class="pay-item">
          <text>优惠券</text>
          <view class="pay-item__right" catchtap="onOpenCoupons">
            <block wx:if="{{order.couponAmount}}">
              <text wx:if="{{order.couponSnapshot && order.couponSnapshot.title}}" class="order-no normal-color">
                {{order.couponSnapshot.title}}
              </text>
              -
              <price fill decimalSmaller price="{{order.couponAmount}}" />
            </block>
            <text wx:else>无可用</text>
            <!-- <t-icon name="chevron-right" size="32rpx" color="#BBBBBB" /> -->
          </view>
        </view>
        <view class="pay-item" wx:if="{{order.salesNameSnapshot}}">
          <text>销售</text>
          <view class="pay-item__right">
            <text>{{order.salesNameSnapshot}}</text>
          </view>
        </view>
        <view class="pay-item">
          <text>{{isPaid ? '实付' : '应付'}}</text>
          <price
            fill
            decimalSmaller
            wr-class="pay-item__right font-bold primary max-size"
            price="{{order.paymentAmount || '0'}}"
          />
        </view>
      </view>
    </order-card>
    <view class="pay-detail padding-inline">
      <view class="pay-item">
        <text>订单编号</text>
        <view class="pay-item__right" bindtap="onOrderNumCopy">
          <text class="order-no">{{order.orderNo}}</text>
          <view class="pay-item__right__copy">复制</view>
        </view>
      </view>
      <view class="pay-item">
        <text>下单时间</text>
        <view class="pay-item__right">
          <text class="order-no normal-color">{{formatCreateTime}}</text>
        </view>
      </view>
      <view class="border-bottom border-bottom-margin" />
      <view class="pay-item">
        <text>发票</text>
        <view class="pay-item__right" bindtap="onOrderInvoiceView">
          <text class="order-no normal-color">{{invoiceType}}</text>
          <view class="pay-item__right__copy">查看</view>
        </view>
      </view>
      <view class="pay-item">
        <text>备注</text>
        <view class="pay-item__right">
          <text class="order-no normal-color">{{order.remark || '-'}}</text>
        </view>
      </view>
      <view class="pay-item" wx:if="{{order.salesOpenid}}">
        <text>销售openid</text>
        <view class="pay-item__right">
          <text class="order-no normal-color">{{order.salesOpenid}}</text>
        </view>
      </view>
      <view class="border-bottom border-bottom-margin" wx:if="{{showContactService}}" />
      <button
        wx:if="{{showContactService}}"
        class="pay-service contact-service-button"
        open-type="contact"
        session-from="订单号{{order.orderNo}}"
        show-message-card="{{true}}"
        send-message-title="售后咨询：{{order.orderNo}}"
        send-message-path="/pages/order/order-detail/index?orderID={{_order.id}}"
      >
        <t-icon name="service" size="40rpx" />
        <text decode="{{true}}">&nbsp;联系客服</text>
      </button>
    </view>
  </view>
  <view wx:if="{{_order.buttons.length > 0}}" class="bottom-bar">
    <order-button-bar
      order="{{_order}}"
      bindrefresh="onRefresh"
      bindpay="onOrderPay"
      bindconfirmreceived="onConfirmReceived"
      bindcontactservice="onContactServiceFromAfterSale"
      isBtnMax
    />
  </view>
</t-pull-down-refresh>
<view wx:if="{{showAfterSaleContactDialog}}" class="after-sale-contact-mask" catchtouchmove="noop">
  <view class="after-sale-contact-dialog">
    <view class="after-sale-contact-title">即将打开客服对话</view>
    <view class="after-sale-contact-content">客服帮您解决所有售后问题</view>
    <view class="after-sale-contact-actions">
      <button class="after-sale-contact-cancel" bindtap="onAfterSaleContactCancel">取消</button>
      <button
        class="after-sale-contact-confirm"
        open-type="contact"
        session-from="订单号{{order.orderNo}}"
        show-message-card="{{true}}"
        send-message-title="售后咨询：{{order.orderNo}}"
        send-message-path="/pages/order/order-detail/index?orderID={{_order.id}}"
        bindtap="onAfterSaleContactTap"
      >
        确认
      </button>
    </view>
  </view>
</view>
<t-toast id="t-toast" />
<t-dialog id="t-dialog" />
