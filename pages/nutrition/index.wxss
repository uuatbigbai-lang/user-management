page {
  background: #f8faf5;
  --green-primary: #5aaa6e;
  --green-dark: #3d8b4f;
  --text-main: #2d3a2e;
  --text-sub: #7a8a7c;
  --text-light: #a3b5a6;
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ========== Banner ========== */
.banner {
  position: relative;
  padding: 56rpx 44rpx 48rpx;
  overflow: hidden;
}

.banner-bg {
  position: absolute;
  inset: -40rpx -40rpx -30rpx;
  background: linear-gradient(160deg, #e8f5e9 0%, #c8e6c9 40%, #a5d6a7 70%, #e8f5e9 100%);
  border-radius: 0 0 48rpx 48rpx;
  z-index: 0;
}

.banner-deco {
  position: absolute;
  border-radius: 50%;
  z-index: 0;
}

.banner-deco-1 {
  width: 200rpx;
  height: 200rpx;
  top: -40rpx;
  right: -20rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.35) 0%, transparent 70%);
}

.banner-deco-2 {
  width: 100rpx;
  height: 100rpx;
  bottom: 20rpx;
  left: 40rpx;
  border: 2rpx solid rgba(255,255,255,0.25);
}

.banner-content {
  position: relative;
  z-index: 1;
}

.banner-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.banner-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.banner-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.8;
  max-width: 600rpx;
}

/* ========== Tab Bar ========== */
.tab-bar {
  display: flex;
  gap: 12rpx;
  padding: 28rpx 36rpx 8rpx;
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

.tab-bar::-webkit-scrollbar {
  display: none;
}

.tab-item {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  background: #fff;
  border: 1rpx solid rgba(90,170,110,0.12);
  transition: all 0.2s;
}

.tab-item--active {
  background: var(--green-primary);
  color: #fff;
  border-color: var(--green-primary);
  font-weight: 500;
}

/* ========== Article List ========== */
.article-list {
  padding: 20rpx 36rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.article-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  box-shadow: 0 4rpx 24rpx rgba(90,170,110,0.06);
  transition: transform 0.2s;
}

.article-card:active {
  transform: scale(0.985);
}

.article-cover {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #f0f7f1, #e8f5e9);
}

.article-body {
  flex: 1;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 220rpx;
}

.article-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-summary {
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 8rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.article-tag {
  font-size: 20rpx;
  color: var(--green-dark);
  background: #e8f5e9;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.article-date {
  font-size: 20rpx;
  color: var(--text-light);
}

/* ========== Empty ========== */
.empty {
  padding: 80rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-light);
}

/* ========== Footer ========== */
.list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 60rpx 16rpx;
  gap: 16rpx;
}

.footer-line {
  flex: 1;
  height: 1rpx;
  background: rgba(90,170,110,0.15);
}

.footer-text {
  font-size: 20rpx;
  color: var(--text-light);
  white-space: nowrap;
  letter-spacing: 1rpx;
}