:host {
  background-color: #f5f5f5;
}
page view {
  box-sizing: border-box;
}
.person-info {
  padding-top: 20rpx;
}

.avatarUrl {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50% !important;
  overflow: hidden;
}

.avatar-picker {
  padding: 0;
  margin: 0;
  line-height: 1;
  background: transparent;
  border: 0;
}

.avatar-picker::after {
  border: 0;
}

.t-class-confirm {
  color: #3075B8 !important;
}

.person-info .order-group__left {
  margin-right: 0;
}
.person-info .t-cell-class {
  height: 112rpx;
}

.phone-login-popup {
  background: #fff;
  margin-bottom: env(safe-area-inset-bottom);
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx 40rpx;
}

.phone-login-popup__title {
  color: #1f2937;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.phone-login-popup__desc {
  margin-top: 18rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.7;
}

.phone-login-popup__privacy {
  margin-top: 18rpx;
  color: #3075B8;
  font-size: 24rpx;
  text-align: center;
}

.phone-login-popup__confirm {
  margin-top: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #3075B8 0%, #245f98 100%);
  color: #fff;
  font-size: 30rpx;
  border: none;
}

.phone-login-popup__cancel {
  margin-top: 20rpx;
  color: #98a2b3;
  font-size: 28rpx;
  text-align: center;
}
