<t-tabs
  defaultValue="{{status}}"
  bind:change="tabChange"
  tabList="{{list}}"
  t-class="tabs-external__inner"
	t-class-item="tabs-external__item"
  t-class-active="tabs-external__active"
  t-class-track="tabs-external__track"
>
	<t-tab-panel
	  wx:for="{{list}}"
	  wx:for-index="index"
	  wx:for-item="tab"
	  wx:key="key"
	  label="{{tab.text}}"
	  value="{{tab.key}}"
	/>
</t-tabs>
<view class="coupon-list-wrap">
	<t-pull-down-refresh
	  t-class-indicator="t-class-indicator"
	  id="t-pull-down-refresh"
	  bind:refresh="onPullDownRefresh_"
	  background="#fff"
	>
		<view class="coupon-list-item" wx:for="{{couponList}}" wx:key="key">
			<coupon-card couponDTO="{{item}}" hideOperator="{{true}}" />
		</view>
		<view wx:if="{{!loading && !couponList.length && !errorMessage}}" class="coupon-empty">
			<view class="coupon-empty__title">暂无已领取的优惠券</view>
			<view class="coupon-empty__desc">领取优惠券后，会展示在这里</view>
		</view>
		<view wx:if="{{!loading && errorMessage}}" class="coupon-empty">
			<view class="coupon-empty__title">优惠券加载失败</view>
			<view class="coupon-empty__desc">下拉页面可重新加载</view>
		</view>
	</t-pull-down-refresh>
</view>
