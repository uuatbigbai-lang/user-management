.invite-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 56rpx;
  background:
    radial-gradient(circle at top right, rgba(48, 117, 184, 0.18), transparent 28%),
    linear-gradient(180deg, #f4f9ff 0%, #eef6f5 100%);
}

.invite-shell {
  display: grid;
  gap: 24rpx;
}

.state-card,
.hero-card,
.info-card {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 40rpx rgba(25, 53, 89, 0.08);
}

.state-card {
  padding: 48rpx 36rpx;
  text-align: center;
  color: #4d647d;
  font-size: 28rpx;
  line-height: 42rpx;
}

.state-card--error {
  color: #b42318;
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.state-desc {
  margin-bottom: 28rpx;
}

.hero-card {
  padding: 40rpx 36rpx;
  background:
    linear-gradient(135deg, rgba(48, 117, 184, 0.96) 0%, rgba(77, 169, 135, 0.92) 100%);
  color: #ffffff;
}

.hero-badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  line-height: 32rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 700;
}

.hero-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  color: rgba(255, 255, 255, 0.9);
}

.coupon-pill {
  margin-top: 24rpx;
  display: inline-block;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 24rpx;
  line-height: 36rpx;
}

.info-card {
  padding: 12rpx 28rpx;
}

.info-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  margin-bottom: 10rpx;
  color: #7b8794;
  font-size: 24rpx;
  line-height: 34rpx;
}

.info-value {
  color: #132238;
  font-size: 30rpx;
  line-height: 44rpx;
  word-break: break-word;
}

.share-tip {
  color: #5f6f82;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.share-btn,
.ghost-btn {
  width: 100%;
  min-height: 92rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 92rpx;
  font-weight: 700;
}

.share-btn {
  background: linear-gradient(135deg, #3075b8 0%, #1f5f9f 100%);
  color: #ffffff;
}

.ghost-btn {
  background: #ffffff;
  color: #3075b8;
  border: 2rpx solid rgba(48, 117, 184, 0.2);
}
