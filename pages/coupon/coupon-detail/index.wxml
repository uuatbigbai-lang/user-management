<view wx:if="{{errorMessage}}" class="error-wrap">
  <view class="error-title">优惠券详情展示失败</view>
  <view class="error-desc">{{errorMessage}}</view>
  <t-button shape="round" block bindtap="goHomeHandle">去首页逛逛</t-button>
</view>

<view wx:else>
  <!-- 说明 -->
  <view class="desc-wrap">
  <t-cell-group t-class="desc-group-wrap">
    <t-cell
      wx:if="{{detail && detail.desc}}"
      t-class="t-class-cell"
      t-class-title="t-class-title"
      t-class-note="t-class-note"
      title="规则说明"
      note="{{detail && detail.desc}}"
    />
    <t-cell
      wx:if="{{detail && detail.timeLimit}}"
      t-class="t-class-cell"
      t-class-title="t-class-title"
      t-class-note="t-class-note"
      title="有效时间"
      note="{{detail && detail.timeLimit}}"
    />
    <t-cell
      wx:if="{{fromMine && detail}}"
      t-class="t-class-cell"
      t-class-title="t-class-title"
      t-class-note="t-class-note"
      title="使用状态"
      note="{{detail.usageStatusText}}"
    />
    <t-cell
      wx:if="{{fromMine && detail && detail.recordStatus === 'used' && detail.usedAtText}}"
      t-class="t-class-cell"
      t-class-title="t-class-title"
      t-class-note="t-class-note"
      title="使用时间"
      note="{{detail.usedAtText}}"
    />
    <t-cell
      wx:if="{{fromMine && detail && detail.recordStatus === 'used' && detail.orderNo}}"
      t-class="t-class-cell"
      t-class-title="t-class-title"
      t-class-note="t-class-note"
      title="关联订单"
      note="{{detail.orderNo}}"
    />
    <t-cell
      wx:if="{{fromMine && detail && detail.recordStatus === 'used' && detail.discountAmountText}}"
      t-class="t-class-cell"
      t-class-title="t-class-title"
      t-class-note="t-class-note"
      title="实际优惠"
      note="{{detail.discountAmountText}}"
    />
    <t-cell
      wx:if="{{detail && detail.storeAdapt}}"
      t-class="t-class-cell"
      t-class-title="t-class-title"
      t-class-note="t-class-note"
      title="适用范围"
      note="{{detail && detail.storeAdapt}}"
    />
    <t-cell
      wx:if="{{detail && detail.useNotes}}"
      t-class="t-class-cell"
      t-class-title="t-class-title"
      t-class-note="t-class-note"
      title="使用须知"
      note="{{detail && detail.useNotes}}"
    />
  </t-cell-group>
  <!-- 查看可用商品 -->
  <view class="button-wrap">
    <t-button wx:if="{{fromShare && !claimed}}" shape="round" block bindtap="claimHandle">领取优惠券</t-button>
    <t-button wx:elif="{{detail && detail.canForward}}" shape="round" block bindtap="forwardHandle">继续转发给好友</t-button>
    <t-button wx:elif="{{fromShare && claimed}}" shape="round" block bindtap="goHomeHandle">领取成功，去首页逛逛</t-button>
    <t-button wx:elif="{{fromMine && detail && detail.recordStatus === 'used' && detail.orderNo}}" shape="round" block bindtap="goOrderHandle">查看关联订单</t-button>
    <t-button wx:else shape="round" block bindtap="navGoodListHandle"> 查看可用商品 </t-button>
  </view>
  </view>
</view>
