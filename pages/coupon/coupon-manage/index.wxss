page {
  background: #f6f8f5;
}

.page {
  padding: 32rpx;
}

.header {
  margin-bottom: 28rpx;
}

.title {
  color: #203326;
  font-size: 40rpx;
  font-weight: 700;
}

.desc {
  margin-top: 10rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 38rpx;
}

.coupon-type {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 20rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 18rpx rgba(48, 117, 184, 0.08);
}

.coupon-title {
  color: #203326;
  font-size: 30rpx;
  font-weight: 700;
}

.coupon-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.coupon-tip {
  margin-top: 8rpx;
  color: #3075B8;
  font-size: 22rpx;
}

.experience-config {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef1f4;
}

.experience-config__title {
  color: #344054;
  font-size: 24rpx;
  font-weight: 700;
}

.experience-config__desc {
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 32rpx;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 42rpx 0 20rpx;
}

.section-title {
  color: #203326;
  font-size: 34rpx;
  font-weight: 700;
}

.section-desc {
  margin-top: 6rpx;
  color: #667085;
  font-size: 24rpx;
}

.empty {
  padding: 48rpx 24rpx;
  color: #667085;
  font-size: 26rpx;
  text-align: center;
}

.coupon-record {
  margin-bottom: 20rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 18rpx rgba(48, 117, 184, 0.08);
}

.record-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 14rpx;
}

.record-title {
  color: #203326;
  font-size: 30rpx;
  font-weight: 700;
}

.record-status {
  flex: none;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #eef7f0;
  color: #3075B8;
  font-size: 22rpx;
  font-weight: 700;
}

.status-used {
  background: #f2f4f7;
  color: #667085;
}

.status-expired {
  background: #fff1f3;
  color: #c01048;
}

.record-line {
  color: #667085;
  font-size: 24rpx;
  line-height: 36rpx;
  word-break: break-all;
}

.goods-popup {
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx;
}

.goods-popup__title {
  color: #203326;
  font-size: 34rpx;
  font-weight: 700;
}

.goods-popup__desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 36rpx;
}

.goods-popup__search {
  height: 72rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f4f6f8;
  font-size: 26rpx;
}

.goods-popup__summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  color: #667085;
  font-size: 24rpx;
}

.goods-popup__clear {
  color: #3075B8;
}

.goods-popup__list {
  max-height: 720rpx;
  margin-top: 18rpx;
}

.goods-option {
  display: block;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e4e7ec;
  border-radius: 18rpx;
  background: #ffffff;
  transition: all 0.2s ease;
}

.goods-option--active {
  border-color: #3075B8;
  background: linear-gradient(135deg, #eef6ff, #e3f0ff);
  box-shadow: 0 10rpx 24rpx rgba(48, 117, 184, 0.16);
}

.goods-option__title {
  color: #203326;
  font-size: 28rpx;
  font-weight: 700;
}

.goods-option--active .goods-option__title {
  color: #1d4f84;
}

.goods-option__meta {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
}

.goods-popup__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.goods-popup__btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
}

.goods-popup__btn::after {
  border: 0;
}

.goods-popup__btn--ghost {
  background: #f2f4f7;
  color: #344054;
}

.goods-popup__btn--primary {
  background: #3075B8;
  color: #fff;
}

.record-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.record-actions button {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.record-actions button::after {
  border: 0;
}

.record-share {
  background: #3075B8;
  color: #fff;
}

.record-void {
  background: #fff1f3;
  color: #c01048;
}
