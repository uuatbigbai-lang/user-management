:host {
  padding-bottom: 120rpx;
}

.sample-page {
  min-height: 100vh;
  background: #f8faf5;
  padding: 24rpx;
  box-sizing: border-box;
}

.sample-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 12rpx 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 170, 110, 0.06);
}

.sample-tabs {
  background: #ffffff !important;
  --td-tab-nav-bg-color: transparent;
  --td-tab-border-color: transparent;
  --td-tab-track-color: #5aaa6e;
}

.sample-tabs__item {
  font-size: 28rpx;
  color: #7a8a7c !important;
}

.sample-tabs__active {
  color: #2d3a2e !important;
  font-weight: 600;
}

.sample-actions {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.sample-actions .t-button {
  --td-button-primary-bg-color: #198f3d;
  --td-button-primary-border-color: #5aaa6e;
  --td-button-primary-active-bg-color: #3d8b4f;
  --td-button-primary-active-border-color: #3d8b4f;
  --td-button-primary-text-color: #fff;
  --td-button-default-bg-color: #ffffff;
  --td-button-default-border-color: rgba(90, 170, 110, 0.3);
  --td-button-default-color: #5aaa6e;
  --td-button-default-active-bg-color: #f0f7f1;
  --td-button-default-active-border-color: #5aaa6e;
  --td-button-border-radius: 48rpx;
  border-radius: 48rpx !important;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(90, 170, 110, 0.1);
}

.sample-list {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sample-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 170, 110, 0.06);
  transition: transform 0.2s;
}

.sample-item:active {
  transform: scale(0.985);
}

.sample-item__row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #2d3a2e;
}

.sample-item__label {
  color: #a3b5a6;
}

.sample-item__value {
  font-weight: 500;
  color: #2d3a2e;
}

.sample-loading,
.sample-empty,
.sample-load-more {
  text-align: center;
  font-size: 26rpx;
  color: #a3b5a6;
  padding: 24rpx 0;
}