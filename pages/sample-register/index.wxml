<view class="register-page">
  <view class="register-header">
    <t-button theme="primary" block size="large" bind:tap="onSampleVideoTap">
      观看采样视频
    </t-button>
  </view>

  <view class="register-form">
    <view class="section-title">基本信息</view>

    <view class="form-item">
      <view class="form-title">样本编号<text class="required">*</text></view>
      <t-input
        class="form-input"
        placeholder="请输入样本编号"
        value="{{form.sampleNo}}"
        bind:change="onInputChange"
        data-key="sampleNo"
      />
    </view>
    <view class="form-item">
      <view class="form-title">姓名<text class="required">*</text></view>
      <t-input
        class="form-input"
        placeholder="请输入姓名"
        value="{{form.name}}"
        bind:change="onInputChange"
        data-key="name"
      />
    </view>
    <view class="form-item">
      <view class="form-title">年龄<text class="required">*</text></view>
      <t-input
        class="form-input"
        placeholder="请输入年龄"
        type="number"
        value="{{form.age}}"
        bind:change="onInputChange"
        data-key="age"
      />
    </view>
    <view class="form-item">
      <view class="form-title">性别<text class="required">*</text></view>
      <t-radio-group
        value="{{form.gender}}"
        bind:change="onInputChange"
        data-key="gender"
        class="radio-group"
      >
        <t-radio
          wx:for="{{genderOptions}}"
          wx:key="value"
          value="{{item.value}}"
          label="{{item.label}}"
        />
      </t-radio-group>
    </view>
    <view class="form-item">
      <view class="form-title">手机号<text class="required">*</text></view>
      <t-input
        class="form-input"
        placeholder="请输入手机号"
        type="number"
        value="{{form.phone}}"
        bind:change="onInputChange"
        data-key="phone"
      />
    </view>
    <view class="form-item">
      <view class="form-title">城市<text class="required">*</text></view>
      <t-input
        class="form-input"
        placeholder="请输入城市"
        value="{{form.city}}"
        bind:change="onInputChange"
        data-key="city"
      />
    </view>

    <view class="form-divider"></view>
    <view class="section-title">身体指标</view>

    <view class="form-item">
      <view class="form-title">身高（厘米）<text class="required">*</text></view>
      <t-input
        class="form-input"
        placeholder="请输入身高"
        type="number"
        value="{{form.height}}"
        bind:change="onInputChange"
        data-key="height"
      />
    </view>
    <view class="form-item">
      <view class="form-title">体重（公斤）<text class="required">*</text></view>
      <t-input
        class="form-input"
        placeholder="请输入体重"
        type="number"
        value="{{form.weight}}"
        bind:change="onInputChange"
        data-key="weight"
      />
    </view>

    <block wx:if="{{type === 'gut'}}">
      <view class="form-divider"></view>
      <view class="section-title">肠道菌群检测信息</view>
      <view class="form-item">
        <view class="form-title">日常排便频率<text class="required">*</text></view>
        <t-input
          class="form-input"
          placeholder="如每日1次、两日1次"
          value="{{form.bowelFrequency}}"
          bind:change="onInputChange"
          data-key="bowelFrequency"
        />
      </view>
      <view class="form-item">
        <view class="form-title">近期大便性状<text class="required">*</text></view>
        <t-input
          class="form-input"
          placeholder="如成形、偏稀、便秘"
          value="{{form.stoolShape}}"
          bind:change="onInputChange"
          data-key="stoolShape"
        />
      </view>
      <view class="form-item">
        <view class="form-title">近期肠胃症状<text class="required">*</text></view>
        <t-textarea
          class="form-textarea"
          placeholder="如腹胀、腹痛、腹泻、便秘等，没有请填无"
          value="{{form.digestiveSymptoms}}"
          bind:change="onInputChange"
          data-key="digestiveSymptoms"
        />
      </view>
    </block>

    <block wx:elif="{{type === 'vaginal'}}">
      <view class="form-divider"></view>
      <view class="section-title">阴道菌群检测信息</view>
      <view class="form-item">
        <view class="form-title">当前月经状态<text class="required">*</text></view>
        <t-input
          class="form-input"
          placeholder="如经期前、经期后、绝经、孕期"
          value="{{form.menstrualStatus}}"
          bind:change="onInputChange"
          data-key="menstrualStatus"
        />
      </view>
      <view class="form-item">
        <view class="form-title">是否怀孕<text class="required">*</text></view>
        <t-radio-group
          value="{{form.pregnant}}"
          bind:change="onInputChange"
          data-key="pregnant"
          class="radio-group"
        >
          <t-radio
            wx:for="{{yesNoOptions}}"
            wx:key="value"
            value="{{item.value}}"
            label="{{item.label}}"
          />
        </t-radio-group>
      </view>
      <view class="form-item">
        <view class="form-title">近期是否使用阴道用药或抗生素<text class="required">*</text></view>
        <t-radio-group
          value="{{form.vaginalMedication}}"
          bind:change="onInputChange"
          data-key="vaginalMedication"
          class="radio-group"
        >
          <t-radio
            wx:for="{{yesNoOptions}}"
            wx:key="value"
            value="{{item.value}}"
            label="{{item.label}}"
          />
        </t-radio-group>
      </view>
      <view class="form-item">
        <view class="form-title">近期相关症状<text class="required">*</text></view>
        <t-textarea
          class="form-textarea"
          placeholder="如瘙痒、异味、分泌物异常等，没有请填无"
          value="{{form.vaginalSymptoms}}"
          bind:change="onInputChange"
          data-key="vaginalSymptoms"
        />
      </view>
    </block>

    <block wx:elif="{{type === 'inflammation'}}">
      <view class="form-divider"></view>
      <view class="section-title">肠道炎症检测信息</view>
      <view class="form-item">
        <view class="form-title">近期肠道不适情况<text class="required">*</text></view>
        <t-textarea
          class="form-textarea"
          placeholder="如腹泻、便血、腹痛、发热等，没有请填无"
          value="{{form.inflammationSymptoms}}"
          bind:change="onInputChange"
          data-key="inflammationSymptoms"
        />
      </view>
      <view class="form-item">
        <view class="form-title">近期是否使用消炎药或肠道相关药物<text class="required">*</text></view>
        <t-radio-group
          value="{{form.inflammationMedication}}"
          bind:change="onInputChange"
          data-key="inflammationMedication"
          class="radio-group"
        >
          <t-radio
            wx:for="{{yesNoOptions}}"
            wx:key="value"
            value="{{item.value}}"
            label="{{item.label}}"
          />
        </t-radio-group>
      </view>
    </block>

    <view class="form-item" wx:if="{{showAntibiotics}}">
      <view class="form-title">
        两周内是否使用过抗生素、止泻药或者导泻药等影响肠道菌群的药物？若是用过，会影响检测结果的精准性，建议超过两周后再来检测。
        <text class="required">*</text>
      </view>
      <t-radio-group
        value="{{form.antibiotics}}"
        bind:change="onInputChange"
        data-key="antibiotics"
        class="radio-group"
      >
        <t-radio
          wx:for="{{antibioticsOptions}}"
          wx:key="value"
          value="{{item.value}}"
          label="{{item.label}}"
        />
      </t-radio-group>
    </view>

    <view class="form-divider"></view>
    <view class="section-title">其他信息</view>

    <view class="form-item">
      <view class="form-title">您是从哪个渠道获得检测盒?<text class="required">*</text></view>
      <t-input
        class="form-input"
        placeholder="请输入渠道"
        value="{{form.channel}}"
        bind:change="onInputChange"
        data-key="channel"
      />
    </view>
    <view class="form-item">
      <view class="form-title">备注（主诉）<text class="required">*</text></view>
      <t-textarea
        class="form-textarea"
        placeholder="请输入备注"
        value="{{form.remark}}"
        bind:change="onInputChange"
        data-key="remark"
      />
    </view>
  </view>

  <view class="register-actions">
    <t-button
      theme="primary"
      block
      size="large"
      loading="{{submitting}}"
      bind:tap="onSubmit"
    >
      上传信息
    </t-button>
  </view>
</view>
