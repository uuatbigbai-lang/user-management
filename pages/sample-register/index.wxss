:host {
  padding-bottom: 120rpx;
}

.register-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.register-header {
  margin-bottom: 24rpx;
}

.register-header .t-button {
  --td-button-primary-bg-color: #fa4126;
  --td-button-primary-border-color: #fa4126;
}

.register-form {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-title {
  font-size: 28rpx;
  color: #333333;
  line-height: 40rpx;
}

.required {
  color: #fa4126;
  margin-left: 6rpx;
}

.form-input {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  background: #ffffff;
}

.form-textarea {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  background: #ffffff;
  min-height: 140rpx;
}

.register-actions {
  margin-top: 24rpx;
}

.register-actions .t-button {
  --td-button-primary-bg-color: #fa4126;
  --td-button-primary-border-color: #fa4126;
}
