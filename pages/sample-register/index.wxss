page {
  background-color: #f8faf5;
}

.register-page {
  min-height: 100vh;
  padding: 24rpx 30rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部采样视频按钮 */
.register-header {
  margin-bottom: 28rpx;
}

.register-header .t-button {
  --td-button-primary-bg-color: #5aaa6e;
  --td-button-primary-border-color: #5aaa6e;
  --td-button-primary-active-bg-color: #3d8b4f;
  --td-button-primary-active-border-color: #3d8b4f;
  border-radius: 16rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 表单卡片 */
.register-form {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(90, 170, 110, 0.06);
}

/* 单个表单项 */
.form-item {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.form-title {
  font-size: 28rpx;
  color: #333333;
  line-height: 40rpx;
  font-weight: 500;
}

.required {
  color: #5aaa6e;
  margin-left: 6rpx;
  font-weight: 600;
}

/* 输入框 */
.form-input {
  border: 2rpx solid #dce8dc;
  border-radius: 14rpx;
  padding: 8rpx 16rpx;
  background: #fbfdf9;
  --td-input-placeholder-color: #b5c9b5;
  transition: border-color 0.2s;
}

.form-input--focus {
  border-color: #5aaa6e;
}

/* 多行文本 */
.form-textarea {
  border: 2rpx solid #dce8dc;
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  background: #fbfdf9;
  min-height: 160rpx;
  --td-textarea-placeholder-color: #b5c9b5;
}

/* 单选组 */
.radio-group {
  display: flex;
  flex-direction: row;
  gap: 40rpx;
  padding: 8rpx 0;
  --td-radio-icon-checked-color: #5aaa6e;
  --td-radio-btn-checked-bg-color: #e8f5e9;
  --td-radio-btn-checked-color: #5aaa6e;
}

/* 分隔线 */
.form-divider {
  height: 1rpx;
  background: #eef4ee;
  margin: 4rpx 0;
}

/* 底部提交按钮 */
.register-actions {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  z-index: 100;
}

.register-actions .t-button {
  --td-button-primary-bg-color: #5aaa6e;
  --td-button-primary-border-color: #5aaa6e;
  --td-button-primary-active-bg-color: #3d8b4f;
  --td-button-primary-active-border-color: #3d8b4f;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  height: 88rpx;
}

/* section 标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d5a35;
  padding-bottom: 8rpx;
  border-bottom: 4rpx solid #5aaa6e;
  display: inline-block;
  margin-bottom: 8rpx;
}