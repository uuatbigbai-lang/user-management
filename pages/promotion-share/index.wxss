page {
  background-color: #f8faf5;
}

.promo-page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* Banner */
.promo-banner {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #5aaa6e 0%, #3d8b4f 100%);
  padding: 80rpx 40rpx 60rpx;
  text-align: center;
  border-radius: 0 0 40rpx 40rpx;
}

.banner-deco-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
  background: #fff;
}

.banner-deco-circle.c1 {
  width: 200rpx;
  height: 200rpx;
  top: -40rpx;
  right: -30rpx;
}

.banner-deco-circle.c2 {
  width: 120rpx;
  height: 120rpx;
  bottom: -20rpx;
  left: 40rpx;
}

.banner-deco-circle.c3 {
  width: 80rpx;
  height: 80rpx;
  top: 30rpx;
  left: 60rpx;
  opacity: 0.06;
}

.banner-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}

.banner-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  background: #fff;
  margin: -30rpx 30rpx 0;
  border-radius: 20rpx;
  padding: 36rpx 0;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 30rpx rgba(90, 170, 110, 0.1);
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #2d5a35;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 22rpx;
  color: #999;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: #e8f5e9;
}

/* 邀请码 */
.invite-card {
  margin: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 170, 110, 0.06);
}

.invite-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.invite-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.invite-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.invite-code-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #e8f5e9 0%, #f0f9f1 100%);
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  border: 2rpx dashed #5aaa6e;
}

.invite-code {
  font-size: 44rpx;
  font-weight: 700;
  color: #2d5a35;
  letter-spacing: 8rpx;
}

.invite-copy-btn {
  background: #5aaa6e;
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
}

.invite-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

/* 规则卡片 */
.rules-card {
  margin: 0 30rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 170, 110, 0.06);
}

.rules-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.rules-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.rules-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.rule-steps {
  position: relative;
  padding-left: 20rpx;
}

.rule-step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 36rpx;
  position: relative;
}

.rule-step:last-child {
  margin-bottom: 0;
}

.rule-step::before {
  content: '';
  position: absolute;
  left: 20rpx;
  top: 50rpx;
  width: 2rpx;
  height: calc(100% + 10rpx);
  background: #e8f5e9;
}

.rule-step:last-child::before {
  display: none;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #5aaa6e, #3d8b4f);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.step-content {
  flex: 1;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.step-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 38rpx;
}

.highlight {
  color: #5aaa6e;
  font-weight: 600;
}

/* 明细卡片 */
.detail-card {
  margin: 0 30rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 170, 110, 0.06);
}

.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.detail-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.detail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.detail-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.detail-time {
  font-size: 22rpx;
  color: #999;
}

.detail-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #5aaa6e;
  text-align: right;
}

.detail-amount.pending {
  color: #ccc;
}

.detail-status {
  display: block;
  font-size: 20rpx;
  font-weight: 400;
  color: #999;
}

.detail-empty {
  text-align: center;
  padding: 40rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #ccc;
}

/* 底部按钮 */
.bottom-action {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  z-index: 100;
}

.share-btn {
  background: linear-gradient(135deg, #5aaa6e 0%, #3d8b4f 100%);
  color: #fff;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}