page {
  background-color: #f8faf5;
}

.content-wrapper {
  margin-top: 400rpx;
  position: relative;
  padding: 0 30rpx;
}

/* 推广有礼入口 */
.promo-entry {
  box-shadow: 4px 4px 6px 0px rgb(171, 171, 171);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 170, 110, 0.12);
}

.promo-entry__left {
  display: flex;
  align-items: center;
}

.promo-entry__icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(90, 170, 110, 0.15);
}

.promo-entry__icon {
  font-size: 40rpx;
}

.promo-entry__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d5a35;
  margin-bottom: 4rpx;
}

.promo-entry__desc {
  font-size: 22rpx;
  color: #5aaa6e;
}

.promo-entry__right {
  display: flex;
  align-items: center;
}

.promo-entry__badge {
  background: #5aaa6e;
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
}

.main-content {
  height: 500rpx;
}

.order-group-wrapper {
  margin-bottom: 16rpx;
}

.admin-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 28rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 170, 110, 0.08);
}

.admin-entry__title {
  color: #2d5a35;
  font-size: 30rpx;
  font-weight: 700;
}

.admin-entry__desc {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
}

.order-group-note {
  font-size: 28rpx;
}

.cell-box {
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 170, 110, 0.06);
}
.icon-color {
  color: #a3b5a6;
}
.cell-class {
  height: 100rpx;
  display: flex;
  align-items: center;
}

.order-content {
  overflow: hidden;
  width: 100%;
  display: flex;
  background-color: #fff;
  border-radius: 20rpx;
}

.order-item {
  flex: 1;
  height: 180rpx;
  overflow: hidden;
  position: relative;
  text-align: center;
}

.order-content-box {
  margin: auto;
  position: absolute;
  width: 100%;
  top: 50%;
  left: 50%;
  -webkit-transform: translate(-50%, -50%);
  -ms-transform: translate(-50%, -50%);
  transform: translate(-50%, -50%);
}
.order-content-t {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #2d3a2e;
  letter-spacing: 0;
  text-align: center;
}

.popup-content {
  background: #f8faf5;
  margin-bottom: env(safe-area-inset-bottom);
  border-radius: 24rpx 24rpx 0 0;
}
.popup-content .popup-title {
  background: #fff;
  text-align: center;
  font-size: 24rpx;
  color: #a3b5a6;
  height: 112rpx;
  text-align: center;
  line-height: 112rpx;
  border-radius: 24rpx 24rpx 0 0;
}

.border-bottom-1px {
  position: relative;
}

.border-bottom-1px::after {
  position: absolute;
  display: block;
  content: '';
  box-sizing: border-box;
  top: 0;
  left: 0;
  width: 200%;
  height: 200%;
  transform: scale(0.5);
  transform-origin: left top;
  border-bottom: 2rpx solid rgba(90, 170, 110, 0.1);
}
.popup-content .popup-phone,
.popup-content .popup-close {
  background: #fff;
  height: 100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  font-size: 30rpx;
  font-weight: 400;
  color: #2d3a2e;
}
.popup-content .popup-phone.online {
  margin-bottom: 20rpx;
  color: #5aaa6e;
}
.popup-content .popup-phone.online::after {
  content: none;
}
.popup-content .popup-close {
  color: #a3b5a6;
  border: 0;
  margin-top: 16rpx;
}

.my-order {
  border-radius: 20rpx;
}

.footer__version {
  text-align: center;
  margin-top: 50rpx;
  color: #a3b5a6;
  margin-bottom: 4rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}
.cell-box .order-group__left {
  margin-right: 0;
}
.cell-box .t-cell-padding {
  padding: 24rpx 18rpx 24rpx 32rpx;
}
