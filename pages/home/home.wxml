<!-- 小清新益生菌首页 -->
<view class="page" wx:if="{{!pageLoading}}">
  <!-- Hero Banner -->
  <view class="bg" />
  <view class="logo" style="margin-top: calc({{statusBarHeight}}px + 8rpx);">
    <image wx:if="{{homeAssets.logo.src}}" class="logo-img" src="{{homeAssets.logo.src}}" mode="scaleToFill" bindload="onLogoImageLoad" binderror="onLogoImageError" />
    <text wx:else>{{homeAssets.logo.text}}</text>
    <view class="logo-text">
      <text class="up">立康林</text>
      <text class="down">RecoverGreen微生态管家</text>
    </view>
  </view>
  <view class="search-bar" bind:tap="navToSearch">
    <view class="search-icon"></view>
    <text class="search-placeholder">检测/益生菌方案</text>
  </view>
  <view class="banner" wx:if="{{bannerList.length}}">
    <t-swiper t-class="banner-swiper" height="25vh" autoplay loop interval="4000" duration="500" navigation="{{bannerNavigation}}" list="{{bannerList}}" bind:click="onBannerTap" />
  </view>
  <!-- 功能区入口 -->
  <view class="fuction_link">
    <view
      class="feature-item"
      wx:for="{{featureLinks}}"
      wx:key="label"
      data-action="{{item.action}}"
      data-url="{{item.url}}"
      data-open-type="{{item.openType}}"
      hover-class="feature-item--pressed"
      hover-stay-time="120"
      bind:tap="onFeatureTap"
    >
      <image class="feature-icon" src="{{item.iconSrc}}" mode="aspectFit" />
      <text class="feature-label">{{item.label}}</text>
    </view>
  </view>
  <!-- 占位图 -->
  <view class="placeholder-section" wx:if="{{homeAssets.nutritionPlaceholder.src}}">
    <image class="placeholder-img" src="{{homeAssets.nutritionPlaceholder.src}}" mode="widthFix" />
  </view>
  <!-- 产品列表 -->
  <view class="products-section">
    <view class="section-header">
      <text class="section-title">精选推荐</text>
      <text class="section-jump-link" bind:tap="navToProducts">更多方案 ></text>
    </view>
    <view class="product-list">
      <view class="product-card" wx:for="{{products}}" wx:key="id" data-id="{{item.spuId}}" bind:tap="goDetail">
        <view class="product-img-wrap">
          <image class="product-img" src="{{item.thumb}}" mode="aspectFill" />
          <view class="product-badge" wx:if="{{item.badge}}">{{item.badge}}</view>
        </view>
        <view class="product-info">
          <text class="product-name">{{item.title}}</text>
          <text class="product-brief">{{item.brief}}</text>
          <view class="product-bottom">
            <view class="product-price">
              <text class="price-symbol">¥</text>
              <text class="price-num">{{item.price}}</text>
            </view>
            <view class="cart-btn" data-index="{{index}}" catchtap="handleAddCart">
              <t-icon prefix="wr" name="cart" size="32rpx" color="#ffffff" />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
  <!-- 关于我们 -->
  <view class="about-section">
    <view class="about-card">
      <view class="about-top">
        <text class="about-label">ABOUT US</text>
        <text class="about-title">关于立康林</text>
      </view>
      <text class="about-desc">
        立康林定位为「检测 + 干预」闭环肠道微生态健康管理平台。我们希望每一次益生菌干预都不再是随便试试，而是从肠道菌群检测、报告解读到个性化方案推荐，帮你建立自己的肠道健康标准。
      </text>
      <view class="about-stats">
        <view class="stat-item">
          <text class="stat-num">200万+</text>
          <text class="stat-label">菌群样本数据</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">16S</text>
          <text class="stat-label">测序检测</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">IMicAP</text>
          <text class="stat-label">智能平台支持</text>
        </view>
      </view>
      <view class="about-enter" bind:tap="navToAbout">
        <view class="about-enter-inner">
          <text class="about-enter-text">了解更多</text>
          <view class="about-enter-icon">→</view>
        </view>
        <view class="about-enter-glow"></view>
      </view>
    </view>
  </view>
  <!-- 底部 -->
  <view class="footer">
    <text class="footer-text">立康林 © 你的肠道健康守护专家</text>
  </view>
</view>
<!-- Loading -->
<view class="loading-wrap" wx:if="{{pageLoading}}">
  <t-loading theme="circular" size="40rpx" text="加载中..." inherit-color />
</view>
<t-toast id="t-toast" />
