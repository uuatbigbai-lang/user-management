/* ========== 小清新益生菌首页样式 ========== */
page {
  background: #f8faf5;
  box-sizing: border-box;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  --green-primary: #5aaa6e;
  --green-light: #e8f5e9;
  --green-dark: #3d8b4f;
  --text-main: #2d3a2e;
  --text-sub: #7a8a7c;
  --text-light: #a3b5a6;
  --bg-card: #ffffff;
}

.page {
  min-height: 100vh;
}

/* ========== Loading ========== */
.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 80vh;
  color: var(--text-light);
}

.bg {
  height: 40vh;
  position: absolute;
  top: 0;
  width: 100vw;
  background: linear-gradient(180deg, #198f3d 0%, #1a913e 45%, #ffffff 100%);
  z-index: 0;
}

.logo {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: fit-content;
  margin-left: 40rpx;
}

.logo-img {
  width: 110rpx;
  height: 64rpx;
  display: block;
  flex-shrink: 0;
}

.logo-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
  color: #ffffff;
}

.up {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: 2rpx;
}

.down {
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.search-bar {
  position: relative;
  z-index: 1;
  height: 72rpx;
  margin: 32rpx 40rpx 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 0 10rpx 24rpx rgba(35, 105, 54, 0.12);
}

.search-bar:active {
  opacity: 0.92;
}

.search-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #93a198;
  border-radius: 50%;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 4rpx;
  right: -11rpx;
  bottom: -5rpx;
  border-radius: 4rpx;
  background: #93a198;
  transform: rotate(45deg);
}

.search-placeholder {
  color: #9aa6a0;
  font-size: 26rpx;
  line-height: 1;
}

.banner {
  position: relative;
  z-index: 1;
  height: 25vh;
  margin: 28rpx 40rpx 0;
  border-radius: 28rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(35, 105, 54, 0.14);
}

.banner-swiper {
  height: 25vh !important;
  border-radius: 28rpx !important;
  overflow: hidden !important;
  --td-swiper-radius: 28rpx;
}

/* ========== 功能区入口 ========== */
.fuction_link {
  position: relative;
  z-index: 1;
  margin: 28rpx 40rpx 0;
  padding: 30rpx 22rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(35, 105, 54, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.feature-item {
  width: 25%;
  min-width: 0;
  padding: 12rpx 0;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  transition: transform 0.16s ease, background-color 0.16s ease, opacity 0.16s ease;
}

.feature-item--pressed {
  background: rgba(90, 170, 110, 0.08);
  opacity: 0.86;
  transform: scale(0.94);
}

.feature-icon {
  width: 96rpx;
  height: 96rpx;
  display: block;
  flex-shrink: 0;
}

.feature-label {
  max-width: 100%;
  color: var(--text-main);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
}

/* ========== Section Header ========== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: left;
  margin-bottom: 36rpx;
}

.section-line {
  width: 56rpx;
  height: 2rpx;
  background: var(--green-primary);
  opacity: 0.4;
}

.section-title {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text-main);
  margin: 0 24rpx;
  letter-spacing: 4rpx;
}
.section-jump-link {
  margin-right: 40rpx;
  margin-left: auto;
  font-size: 26rpx;
  color: gray;
  font-weight: 300;
}

/* ========== 产品列表 ========== */
.products-section {
  padding: 40rpx 28rpx 20rpx;
}

.product-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.product-card {
  width: calc((100% - 24rpx) / 2);
  background: var(--bg-card);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(90, 170, 110, 0.08);
  transition: transform 0.2s;
}

.product-card:active {
  transform: scale(0.985);
}

.product-img-wrap {
  position: relative;
  width: 100%;
  height: 260rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #f0f7f1, #e8f5e9);
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-badge {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  background: linear-gradient(135deg, var(--green-primary), var(--green-dark));
  color: #fff;
  font-size: 18rpx;
  padding: 5rpx 14rpx;
  border-radius: 20rpx;
  letter-spacing: 1rpx;
}

.product-info {
  min-height: 208rpx;
  padding: 22rpx 20rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-brief {
  font-size: 20rpx;
  color: var(--text-light);
  margin-bottom: 18rpx;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: auto;
}

.product-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 20rpx;
  color: var(--green-primary);
  font-weight: 600;
  margin-right: 2rpx;
}

.price-num {
  font-size: 34rpx;
  color: var(--green-primary);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.cart-btn {
  width: 56rpx;
  height: 52rpx;
  padding: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--green-primary), var(--green-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(90, 170, 110, 0.18);
}

.cart-btn:active {
  transform: scale(0.96);
}

/* ========== 占位图 ========== */
.placeholder-section {
  margin: 58rpx 40rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(35, 105, 54, 0.08);
}

.placeholder-img {
  width: 100%;
  display: block;
}

/* ========== 关于我们 ========== */
.about-section {
  padding: 40rpx 40rpx 20rpx;
}

.about-card {
  background: linear-gradient(170deg, #ffffff 0%, #f0f7f1 100%);
  border-radius: 28rpx;
  padding: 48rpx 36rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(90, 170, 110, 0.08);
  position: relative;
  overflow: hidden;
}

.about-card::after {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(90, 170, 110, 0.06) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.about-top {
  margin-bottom: 24rpx;
}

.about-label {
  font-size: 20rpx;
  color: var(--text-light);
  letter-spacing: 6rpx;
  display: block;
  margin-bottom: 8rpx;
}

.about-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  display: block;
  letter-spacing: 2rpx;
}

.about-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.9;
  display: block;
  margin-bottom: 36rpx;
}

.about-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid rgba(90, 170, 110, 0.12);
  border-bottom: 1rpx solid rgba(90, 170, 110, 0.12);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--green-primary);
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 20rpx;
  color: var(--text-light);
}

/* ========== 了解更多按钮 - 高级感 ========== */
.about-enter {
  display: flex;
  justify-content: center;
  position: relative;
}

.about-enter-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 56rpx;
  background: linear-gradient(135deg, var(--green-primary) 0%, var(--green-dark) 100%);
  border-radius: 48rpx;
  position: relative;
  z-index: 1;
}

.about-enter:active .about-enter-inner {
  opacity: 0.9;
  transform: scale(0.97);
}

.about-enter-text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
  letter-spacing: 4rpx;
}

.about-enter-icon {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 300;
}

.about-enter-glow {
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 100%;
  background: radial-gradient(ellipse, rgba(90, 170, 110, 0.25) 0%, transparent 70%);
  filter: blur(12rpx);
  z-index: 0;
}

/* ========== Footer ========== */
.footer {
  padding: 48rpx 40rpx 32rpx;
  text-align: center;
}

.footer-text {
  font-size: 20rpx;
  color: var(--text-light);
  letter-spacing: 2rpx;
}
